@model EmployeeFormViewModel
@* Màn hình tạo hồ sơ nhân viên, dùng chung partial form với màn hình cập nhật. *@
@{
    ViewData["Title"] = "Thêm nhân viên mới";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Thêm nhân viên mới</h1>
        <p class="page-subtitle">
            Nhập thông tin nhân sự và thiết lập vị trí, hình thức làm việc
        </p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-secondary-custom">
            <i class="fa-solid fa-arrow-left me-1"></i>
            Quay lại
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-8">
        <div class="card card-custom">
            <div class="card-header-custom">
                <i class="fa-solid fa-user-plus text-primary me-2"></i>
                Hồ sơ nhân viên
            </div>
            <div class="card-body p-4">
                <form method="post" asp-action="Create" data-prevent-double-submit="true">
                    <partial name="_EmployeeForm" model="Model" />

                    <div class="d-flex gap-2 pt-2 border-top">
                        <button type="submit"
                                class="btn btn-primary-custom flex-grow-1 justify-content-center">
                            <i class="fa-solid fa-floppy-disk me-1"></i>
                            Lưu hồ sơ nhân viên
                        </button>
                        <a asp-action="Index"
                           class="btn btn-secondary-custom">
                            Hủy bỏ
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
