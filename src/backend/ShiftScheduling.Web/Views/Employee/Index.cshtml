@model EmployeeIndexViewModel

@{
    ViewData["Title"] = "Quản lý nhân viên";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Quản lý nhân viên</h1>
        <p class="page-subtitle">
            Danh sách hồ sơ nhân sự, vị trí, hình thức làm việc và level năng lực
        </p>
    </div>

    <div>
        <a asp-action="Create"
           class="btn btn-primary-custom">
            <i class="fa-solid fa-user-plus me-1"></i>
            Thêm nhân viên
        </a>
    </div>
</div>

<div class="card card-custom mb-4">
    <div class="card-body p-3">
        <form method="get"
              asp-action="Index"
              class="row g-2 align-items-center">

            <div class="col-md">
                <input name="keyword"
                       value="@Model.Keyword"
                       class="form-control form-control-custom"
                       placeholder="Tìm theo mã, họ tên, số điện thoại hoặc email..." />
            </div>

            <div class="col-md-auto">
                <button class="btn btn-secondary-custom"
                        type="submit">
                    <i class="fa-solid fa-magnifying-glass me-1"></i>
                    Tìm kiếm
                </button>

                <a asp-action="Index"
                   class="btn btn-light border">
                    Xóa lọc
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card card-custom p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-custom align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-4">Nhân viên</th>
                    <th>Vị trí</th>
                    <th>Hình thức</th>
                    <th>Level</th>
                    <th>Định mức tuần</th>
                    <th>Trạng thái</th>
                    <th class="text-end pe-4">Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Employees.Items.Count == 0)
                {
                    <tr>
                        <td colspan="7"
                            class="text-center py-5 text-muted">
                            Chưa có dữ liệu nhân viên phù hợp.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var employee in Model.Employees.Items)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">

                                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary fw-bold d-flex
                                                align-items-center justify-content-center"
                                         style="width:40px; height:40px; font-size:0.9rem;">
                                        @employee.FullName.Substring(0, 1).ToUpperInvariant()
                                    </div>

                                    <div>
                                        <div class="fw-bold text-dark">
                                            @employee.FullName
                                        </div>

                                        <div class="small font-monospace text-muted">
                                            @employee.EmployeeCode

                                            @(string.IsNullOrWhiteSpace(employee.PhoneNumber)
                                                ? string.Empty
                                                : " • " + employee.PhoneNumber)
                                        </div>
                                    </div>
                                </div>
                            </td>

                            <td>
                                @if (employee.Position == EmployeePosition.Sales)
                                {
                                    <span class="badge badge-custom badge-primary-custom">
                                        <i class="fa-solid fa-user-tie"></i>
                                        Tư vấn
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-custom badge-active">
                                        <i class="fa-solid fa-cash-register"></i>
                                        Thu ngân
                                    </span>
                                }
                            </td>

                            <td>
                                @if (employee.EmploymentType == EmploymentType.FullTime)
                                {
                                    <span class="fw-semibold text-dark">
                                        <i class="fa-solid fa-briefcase text-primary me-1"></i>
                                        Full-time
                                    </span>
                                }
                                else
                                {
                                    <span class="fw-semibold text-dark">
                                        <i class="fa-solid fa-user-clock text-info me-1"></i>
                                        Part-time
                                    </span>
                                }
                            </td>

                            <td>
                                <span class="badge bg-secondary bg-opacity-10 text-dark border font-monospace">
                                    Level @((int)employee.Level)
                                </span>
                            </td>

                            <td>
                                <span class="fw-semibold text-dark">
                                    @employee.ExpectedWeeklyHours giờ
                                </span>
                            </td>

                            <td>
                                @if (employee.IsActive)
                                {
                                    <span class="badge badge-custom badge-active">
                                        <i class="fa-solid fa-circle-check"></i>
                                        Hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-custom badge-rejected">
                                        <i class="fa-solid fa-circle-xmark"></i>
                                        Ngừng HĐ
                                    </span>
                                }
                            </td>

                            <td class="text-end pe-4">
                                <a asp-action="Edit"
                                   asp-route-id="@employee.EmployeeId"
                                   class="btn btn-sm btn-secondary-custom">

                                    <i class="fa-solid fa-pen-to-square me-1"></i>
                                    Sửa
                                </a>

                                <form asp-action="SetStatus"
                                      asp-route-id="@employee.EmployeeId"
                                      method="post"
                                      class="d-inline"
                                      data-prevent-double-submit="true">

                                    <input type="hidden"
                                           name="isActive"
                                           value="@(!employee.IsActive).ToString().ToLowerInvariant()" />

                                    <button type="submit"
                                            class="btn btn-sm
                                            @(employee.IsActive
                                                ? "btn-outline-danger"
                                                : "btn-outline-success")"
                                            onclick="return confirm('Xác nhận thay đổi trạng thái nhân viên?')">

                                        @(employee.IsActive ? "Ngừng HĐ" : "Mở lại")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.Employees.TotalPages > 1)
{
    <nav class="mt-4"
         aria-label="Phân trang">

        <ul class="pagination justify-content-center">

            <li class="page-item @(!Model.Employees.HasPreviousPage ? "disabled" : string.Empty)">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-keyword="@Model.Keyword"
                   asp-route-page="@(Model.Employees.Page - 1)"
                   asp-route-pageSize="@Model.Employees.PageSize">
                    Trước
                </a>
            </li>

            <li class="page-item disabled">
                <span class="page-link">
                    Trang @Model.Employees.Page / @Model.Employees.TotalPages
                </span>
            </li>

            <li class="page-item @(!Model.Employees.HasNextPage ? "disabled" : string.Empty)">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-keyword="@Model.Keyword"
                   asp-route-page="@(Model.Employees.Page + 1)"
                   asp-route-pageSize="@Model.Employees.PageSize">
                    Sau
                </a>
            </li>
        </ul>
    </nav>
}