@model EmployeeFormViewModel
@{
    ViewData["Title"] = "Chỉnh sửa nhân viên";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Chỉnh sửa nhân viên: @Model.FullName</h1>
        <p class="page-subtitle">Mã nhân viên: @Model.EmployeeCode</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-secondary-custom">
            <i class="fa-solid fa-arrow-left me-1"></i>
            Quay lại
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-8">
        <div class="card card-custom">
            <div class="card-header-custom">
                <i class="fa-solid fa-user-pen text-primary me-2"></i>
                Cập nhật hồ sơ nhân viên
            </div>
            <div class="card-body p-4">
                <form method="post"
                      asp-action="Edit"
                      asp-route-id="@Model.EmployeeId"
                      data-prevent-double-submit="true">
                    <input asp-for="EmployeeId" type="hidden" />
                    <partial name="_EmployeeForm" model="Model" />

                    <div class="d-flex gap-2 pt-2 border-top">
                        <button type="submit"
                                class="btn btn-primary-custom flex-grow-1 justify-content-center">
                            <i class="fa-solid fa-floppy-disk me-1"></i>
                            Lưu thay đổi
                        </button>
                        <a asp-action="Index"
                           class="btn btn-secondary-custom">
                            Hủy bỏ
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
