@model ShiftScheduling.Features.ShiftTransfers.ViewModels.ShiftTransferReviewViewModel
@* Màn hình Quản lý duyệt/từ chối yêu cầu chuyển ca. *@

@{
    ViewData["Title"] = "Duyệt yêu cầu đổi ca";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Duyệt yêu cầu đổi ca</h1>
        <p class="page-subtitle">Hệ thống đã kiểm tra lại dữ liệu mới nhất trước khi cập nhật lịch chính thức.</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary-custom">Quay lại</a>
</div>

<div class="card-custom mb-4">
    <div class="card-header-custom">Thông tin chuyển ca</div>
    <div class="p-4">
        <div class="row g-3">
            <div class="col-md-4">
                <span class="text-muted">Người gửi:</span>
                <strong>@Model.Details.SenderName</strong>
            </div>
            <div class="col-md-4">
                <span class="text-muted">Người nhận:</span>
                <strong>@Model.Details.ReceiverName</strong>
            </div>
            <div class="col-md-4">
                <span class="text-muted">Vị trí:</span>
                <strong>@Model.Details.PositionName</strong>
            </div>
            <div class="col-md-6">
                <span class="text-muted">Ngày / ca:</span>
                <strong>@Model.Details.WorkDate.ToString("dd/MM/yyyy") · @Model.Details.ShiftName</strong>
            </div>
            <div class="col-md-6">
                <span class="text-muted">Kỳ lịch:</span>
                <strong>@Model.Details.PeriodName</strong>
            </div>
        </div>
    </div>
</div>

@if (Model.BlockingErrors.Count > 0)
{
    <div class="alert alert-custom alert-custom-danger">
        <i class="fa-solid fa-circle-exclamation"></i>
        <div>
            <div class="fw-bold mb-1">Yêu cầu chưa đủ điều kiện duyệt</div>
            <ul class="mb-0">
                @foreach (var error in Model.BlockingErrors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    </div>
}

@if (Model.Warnings.Count > 0)
{
    <div class="alert alert-custom alert-custom-warning">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <div>
            <div class="fw-bold mb-1">Cảnh báo ưu tiên</div>
            <ul class="mb-0">
                @foreach (var warning in Model.Warnings)
                {
                    <li>@warning</li>
                }
            </ul>
        </div>
    </div>
}

<div class="card-custom">
    <div class="card-header-custom">Quyết định của Quản lý</div>
    <div class="p-4">
        @if (!Model.Details.CanReview)
        {
            <div class="alert alert-custom alert-custom-warning mb-0">
                Yêu cầu này không còn ở trạng thái chờ Quản lý duyệt.
                Vui lòng quay lại danh sách để tải trạng thái mới nhất.
            </div>
        }
        else
        {
            <form asp-action="Review"
                  asp-route-id="@Model.ShiftTransferRequestId"
                  method="post"
                  data-prevent-double-submit="true">
                <input asp-for="ShiftTransferRequestId" type="hidden" />
                <input asp-for="RowVersion" type="hidden" />
                <div class="mb-4">
                    <label asp-for="ManagerNote" class="form-label fw-semibold"></label>
                    <textarea asp-for="ManagerNote" rows="3" class="form-control form-control-custom"></textarea>
                    <span asp-validation-for="ManagerNote" class="text-danger small"></span>
                </div>
                <div class="d-flex justify-content-end gap-2">
                    <button type="submit" name="approve" value="false" class="btn btn-secondary-custom">
                        <i class="fa-solid fa-xmark"></i>
                        Từ chối
                    </button>
                    <button type="submit"
                            name="approve"
                            value="true"
                            class="btn btn-primary-custom"
                            disabled="@(Model.BlockingErrors.Count > 0 ? "disabled" : null)">
                        <i class="fa-solid fa-check"></i>
                        Duyệt và cập nhật lịch
                    </button>
                </div>
            </form>
        }
    </div>
</div>
