@model ShiftScheduling.Features.ShiftTransfers.ViewModels.ShiftTransferCreateViewModel

@{
    ViewData["Title"] = "Tạo yêu cầu đổi ca";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Tạo yêu cầu đổi ca</h1>
        <p class="page-subtitle">Đổi ca là chuyển một chiều cho đồng nghiệp nhận thay, không phải hoán đổi hai ca.</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary-custom">Quay lại</a>
</div>

<div class="card-custom mb-4">
    <div class="card-header-custom">1. Chọn ca cần chuyển</div>
    <div class="p-4">
        <form method="get" asp-action="Create" class="row g-3 align-items-end">
            <div class="col-md-9">
                <label class="form-label fw-semibold">Ca trong lịch chính thức của tôi</label>
                <select name="shiftAssignmentId" class="form-select form-select-custom">
                    <option value="0">-- Chọn ca --</option>
                    @foreach (var assignment in Model.Assignments)
                    {
                        <option value="@assignment.ShiftAssignmentId"
                                selected="@(Model.ShiftAssignmentId == assignment.ShiftAssignmentId
                                    ? "selected" : null)">
                            @assignment.WorkDate.ToString("dd/MM/yyyy") · @assignment.ShiftName
                            (@assignment.StartTime.ToString("HH:mm") - @assignment.EndTime.ToString("HH:mm"))
                            · @assignment.PeriodName
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-secondary-custom w-100">Chọn ca</button>
            </div>
        </form>
    </div>
</div>

@if (Model.ShiftAssignmentId > 0)
{
    <div class="card-custom">
        <div class="card-header-custom">2. Chọn đồng nghiệp nhận ca</div>
        <div class="p-4">
            <form asp-action="Create" method="post" data-prevent-double-submit="true">
                <input asp-for="ShiftAssignmentId" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="alert alert-custom alert-custom-danger"></div>

                @if (Model.Receivers.Count == 0)
                {
                    <div class="alert alert-custom alert-custom-warning">
                        Không có đồng nghiệp nào hiện đáp ứng đầy đủ điều kiện nhận ca này.
                    </div>
                }
                else
                {
                    <div class="mb-4">
                        <label asp-for="ReceiverEmployeeId" class="form-label fw-semibold"></label>
                        <select asp-for="ReceiverEmployeeId" class="form-select form-select-custom">
                            <option value="0">-- Chọn đồng nghiệp --</option>
                            @foreach (var receiver in Model.Receivers)
                            {
                                <option value="@receiver.EmployeeId">
                                    @receiver.FullName (@receiver.EmployeeCode) ·
                                    @(receiver.Level == EmployeeLevel.Level1 ? "Level 1"
                                        : receiver.Level == EmployeeLevel.Level2 ? "Level 2" : "Level 3") ·
                                    @(receiver.EmploymentType == EmploymentType.FullTime
                                        ? "Toàn thời gian" : "Bán thời gian")
                                </option>
                            }
                        </select>
                        <span asp-validation-for="ReceiverEmployeeId" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Reason" class="form-label fw-semibold"></label>
                        <textarea asp-for="Reason"
                                  rows="4"
                                  class="form-control form-control-custom"
                                  placeholder="Nhập nội dung cần trao đổi với người nhận..."></textarea>
                        <span asp-validation-for="Reason" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-secondary-custom">Hủy</a>
                        <button type="submit" class="btn btn-primary-custom">
                            <i class="fa-solid fa-paper-plane"></i>
                            Gửi yêu cầu
                        </button>
                    </div>
                }
            </form>
        </div>
    </div>
}
