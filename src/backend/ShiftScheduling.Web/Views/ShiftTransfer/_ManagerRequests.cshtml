@using ShiftScheduling.Models.ViewModels
@model PagedResult<ShiftScheduling.Features.ShiftTransfers.ViewModels.ShiftTransferListItemViewModel>

<div class="card-custom">
    <div class="card-header-custom">Danh sách yêu cầu đổi ca</div>
    <div class="table-responsive">
        <table class="table-custom mb-0">
            <thead>
                <tr>
                    <th>Người gửi</th>
                    <th>Người nhận</th>
                    <th>Kỳ lịch</th>
                    <th>Ngày / ca</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-5">
                            Không có yêu cầu phù hợp với điều kiện lọc.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.SenderName</td>
                            <td>@item.ReceiverName</td>
                            <td>@item.PeriodName</td>
                            <td>
                                <div class="fw-semibold">@item.WorkDate.ToString("dd/MM/yyyy")</div>
                                <div class="text-muted small">@item.ShiftName</div>
                            </td>
                            <td>
                                @if (item.ReceiverStatus == ReceiverStatus.Pending)
                                {
                                    <span class="badge badge-custom badge-pending">Chờ người nhận</span>
                                }
                                else if (item.ReceiverStatus == ReceiverStatus.Rejected)
                                {
                                    <span class="badge badge-custom badge-rejected">Người nhận từ chối</span>
                                }
                                else if (item.ApprovalStatus == ApprovalStatus.Pending)
                                {
                                    <span class="badge badge-custom badge-pending">Chờ Quản lý duyệt</span>
                                }
                                else if (item.ApprovalStatus == ApprovalStatus.Approved)
                                {
                                    <span class="badge badge-custom badge-active">Đã duyệt</span>
                                }
                                else
                                {
                                    <span class="badge badge-custom badge-rejected">Đã từ chối</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details"
                                   asp-route-id="@item.ShiftTransferRequestId"
                                   class="btn btn-sm btn-secondary-custom">
                                    Chi tiết
                                </a>
                                @if (item.CanReview)
                                {
                                    <a asp-action="Review"
                                       asp-route-id="@item.ShiftTransferRequestId"
                                       class="btn btn-sm btn-primary-custom ms-1">
                                        Kiểm tra và xử lý
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
