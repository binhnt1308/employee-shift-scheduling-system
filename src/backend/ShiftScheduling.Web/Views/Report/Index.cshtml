@model ShiftScheduling.Features.Reports.ViewModels.ManagerWorkReportOverviewViewModel
@{
    ViewData["Title"] = "Báo cáo tổng hợp ca & giờ làm";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="fa-solid fa-chart-column text-primary me-2"></i>Báo cáo tổng hợp ca & giờ làm</h3>
        <p class="text-muted small mb-0">Tổng hợp số ca, số ngày và tổng số giờ làm việc dựa trên lịch làm việc chính thức đã công bố</p>
    </div>
    <div>
        @if (Model.PeriodOptions.Any())
        {
            <a asp-action="Export" asp-route-schedulePeriodId="@Model.SchedulePeriodId" asp-route-employeeId="@Model.EmployeeIdFilter" asp-route-position="@Model.PositionFilter" asp-route-employmentType="@Model.EmploymentTypeFilter" class="btn btn-outline-success">
                <i class="fa-solid fa-file-csv me-1"></i>Xuất báo cáo (CSV)
            </a>
        }
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card card-custom border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3">
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Kỳ lịch (Đã công bố)</label>
                <select name="schedulePeriodId" class="form-select form-select-sm" onchange="this.form.submit()">
                    @if (!Model.PeriodOptions.Any())
                    {
                        <option value="">-- Chưa có kỳ lịch công bố --</option>
                    }
                    @foreach (var opt in Model.PeriodOptions)
                    {
                        <option value="@opt.SchedulePeriodId" selected="@(opt.SchedulePeriodId == Model.SchedulePeriodId ? "selected" : null)">@opt.PeriodName</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Nhân viên</label>
                <select name="employeeId" class="form-select form-select-sm">
                    <option value="">-- Tất cả nhân viên --</option>
                    @foreach (var emp in Model.EmployeeOptions)
                    {
                        <option value="@emp.EmployeeId" selected="@(emp.EmployeeId == Model.EmployeeIdFilter ? "selected" : null)">@emp.DisplayName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Vị trí</label>
                <select name="position" class="form-select form-select-sm">
                    <option value="">-- Tất cả --</option>
                    <option value="Sales" selected="@(Model.PositionFilter == ShiftScheduling.Models.Enums.EmployeePosition.Sales ? "selected" : null)">Tư vấn</option>
                    <option value="Cashier" selected="@(Model.PositionFilter == ShiftScheduling.Models.Enums.EmployeePosition.Cashier ? "selected" : null)">Thu ngân</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Hình thức</label>
                <select name="employmentType" class="form-select form-select-sm">
                    <option value="">-- Tất cả --</option>
                    <option value="PartTime" selected="@(Model.EmploymentTypeFilter == ShiftScheduling.Models.Enums.EmploymentType.PartTime ? "selected" : null)">Bán thời gian (PT)</option>
                    <option value="FullTime" selected="@(Model.EmploymentTypeFilter == ShiftScheduling.Models.Enums.EmploymentType.FullTime ? "selected" : null)">Toàn thời gian (FT)</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-sm btn-primary-custom w-100 me-2"><i class="fa-solid fa-filter me-1"></i>Lọc</button>
                <a asp-action="Index" asp-route-schedulePeriodId="@Model.SchedulePeriodId" class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-rotate-left"></i></a>
            </div>
        </form>
    </div>
</div>

@if (Model.CoverageSummary is not null)
{
    var summary = Model.CoverageSummary;
    var badgeClass = !summary.HasRequirements
        ? "bg-secondary"
        : summary.IsFullyCovered
            ? "bg-success"
            : "bg-warning text-dark";
    var progressClass = !summary.HasRequirements
        ? "bg-secondary"
        : summary.IsFullyCovered
            ? "bg-success"
            : "bg-warning";
    var progressValue = (summary.CoverageRate ?? 0m)
        .ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    <div class="card card-custom border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                <div>
                    <h5 class="fw-bold mb-0">
                        <i class="fa-solid fa-chart-pie text-primary me-2"></i>Tỷ lệ phủ ca toàn kỳ
                    </h5>
                    <div class="text-muted small mt-1">
                        @if (summary.HasRequirements)
                        {
                            <span>Đã đáp ứng <strong>@summary.TotalCoveredSlots/@summary.TotalRequiredSlots</strong> vị trí định biên</span>
                            <span class="mx-2">•</span>
                            <span>Tư vấn: <strong>@summary.CoveredSalesSlots/@summary.RequiredSalesSlots</strong></span>
                            <span class="mx-2">•</span>
                            <span>Thu ngân: <strong>@summary.CoveredCashierSlots/@summary.RequiredCashierSlots</strong></span>
                        }
                        else
                        {
                            <span>Kỳ lịch chưa thiết lập định biên nhân sự.</span>
                        }
                    </div>
                </div>
                <div>
                    <span class="badge @badgeClass fs-6 px-3 py-2">
                        @summary.FormattedCoverageRate
                    </span>
                </div>
            </div>
            @if (summary.HasRequirements)
            {
                <div class="progress" style="height: 10px;">
                    <div class="progress-bar @progressClass" role="progressbar" style="width: @(progressValue)%" aria-valuenow="@progressValue" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
            }
        </div>
    </div>
}

<div class="card card-custom border-0 shadow-sm mb-4">
    <div class="card-header bg-light py-3 fw-bold">
        <i class="fa-solid fa-table me-2"></i>Bảng tổng hợp số ca và giờ làm - @Model.PeriodName
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 60px;" class="text-center">STT</th>
                        <th>Mã NV</th>
                        <th>Họ tên</th>
                        <th>Vị trí</th>
                        <th>Hình thức</th>
                        <th class="text-center">Số ca</th>
                        <th class="text-center">Số ngày</th>
                        <th class="text-center">Tổng giờ</th>
                        <th>Cảnh báo / Mức dự kiến</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Rows.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">Chưa có dữ liệu tổng hợp.</td>
                        </tr>
                    }
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td class="text-center fw-bold">@row.Index</td>
                            <td><strong class="text-dark">@row.EmployeeCode</strong></td>
                            <td class="fw-semibold">@row.FullName</td>
                            <td>
                                @if (row.Position == ShiftScheduling.Models.Enums.EmployeePosition.Sales)
                                {
                                    <span class="badge bg-primary">Tư vấn</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Thu ngân</span>
                                }
                            </td>
                            <td>
                                @if (row.EmploymentType == ShiftScheduling.Models.Enums.EmploymentType.PartTime)
                                {
                                    <span class="badge bg-outline-secondary border text-dark">PT</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">FT</span>
                                }
                            </td>
                            <td class="text-center font-monospace fw-bold">@row.TotalShifts</td>
                            <td class="text-center font-monospace">@row.TotalWorkDays ngày</td>
                            <td class="text-center font-monospace text-primary fw-bold">@row.FormattedTotalHours</td>
                            <td>
                                @if (row.IsTargetMet)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success"><i class="fa-solid fa-check me-1"></i>@row.Warning</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-dark border border-warning"><i class="fa-solid fa-triangle-exclamation me-1"></i>@row.Warning</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card card-custom border-0 shadow-sm">
    <div class="card-header bg-light py-3 fw-bold">
        <i class="fa-solid fa-clock-rotate-left me-2"></i>Chi tiết ngày công & điều chỉnh giờ làm - @Model.PeriodName
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 60px;" class="text-center">STT</th>
                        <th>Mã NV</th>
                        <th>Họ tên</th>
                        <th>Ngày làm</th>
                        <th>Ca làm việc</th>
                        <th class="text-center">Kế hoạch</th>
                        <th class="text-center">Ghi nhận</th>
                        <th>Nguồn giờ</th>
                        <th>Lý do điều chỉnh</th>
                        <th style="min-width: 320px;">Thao tác điều chỉnh</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Details.Any())
                    {
                        <tr>
                            <td colspan="10" class="text-center py-4 text-muted">Chưa có dữ liệu phân công ca.</td>
                        </tr>
                    }
                    @{
                        var detailIndex = 1;
                    }
                    @foreach (var item in Model.Details)
                    {
                        <tr>
                            <td class="text-center fw-bold">@(detailIndex++)</td>
                            <td><strong class="text-dark">@item.EmployeeCode</strong></td>
                            <td class="fw-semibold">@item.FullName</td>
                            <td>@item.WorkDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="badge bg-light text-dark border">@item.ShiftName</span>
                                <small class="text-muted d-block">@item.ShiftTimeRange</small>
                            </td>
                            <td class="text-center font-monospace">@item.PlannedHours.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)h</td>
                            <td class="text-center font-monospace fw-bold text-primary">@item.EffectiveWorkedHours.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)h</td>
                            <td>
                                @if (item.IsManagerAdjusted)
                                {
                                    <span class="badge bg-warning text-dark"><i class="fa-solid fa-user-pen me-1"></i>Quản lý điều chỉnh</span>
                                }
                                else if (item.HasApprovedLeave)
                                {
                                    <span class="badge bg-info text-dark"><i class="fa-solid fa-calendar-xmark me-1"></i>Nghỉ đã duyệt — tự động 0 giờ</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border"><i class="fa-solid fa-calendar-check me-1"></i>Theo lịch</span>
                                }
                            </td>
                            <td class="small">
                                @if (!string.IsNullOrWhiteSpace(item.AdjustmentReason))
                                {
                                    <span class="text-muted fst-italic">@item.AdjustmentReason</span>
                                }
                                else if (item.HasApprovedLeave)
                                {
                                    <span class="text-info fst-italic">Nghỉ phép được duyệt</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (item.CanAdjust)
                                {
                                    <div class="d-flex align-items-center gap-1 flex-wrap">
                                        <form method="post" asp-action="AdjustWorkdayHours" class="d-flex align-items-center gap-1">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="SchedulePeriodId" value="@Model.SchedulePeriodId" />
                                            <input type="hidden" name="ShiftAssignmentId" value="@item.ShiftAssignmentId" />
                                            <input type="hidden" name="ReturnEmployeeId" value="@Model.EmployeeIdFilter" />
                                            <input type="hidden" name="ReturnPosition" value="@Model.PositionFilter" />
                                            <input type="hidden" name="ReturnEmploymentType" value="@Model.EmploymentTypeFilter" />
                                            <input type="number" step="0.25" min="0" max="24" name="ActualWorkedHours" value="@item.EffectiveWorkedHours.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" class="form-control form-control-sm text-end" style="width: 75px;" required />
                                            <input type="text" name="WorkdayAdjustmentReason" value="@(item.IsManagerAdjusted ? item.AdjustmentReason : "")" placeholder="Lý do điều chỉnh..." class="form-control form-control-sm" style="width: 140px;" maxlength="500" />
                                            <button type="submit" class="btn btn-sm btn-primary-custom" title="Lưu điều chỉnh"><i class="fa-solid fa-check"></i> Lưu</button>
                                        </form>
                                        @if (item.IsManagerAdjusted)
                                        {
                                            <form method="post" asp-action="AdjustWorkdayHours" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="SchedulePeriodId" value="@Model.SchedulePeriodId" />
                                                <input type="hidden" name="ShiftAssignmentId" value="@item.ShiftAssignmentId" />
                                                <input type="hidden" name="ReturnEmployeeId" value="@Model.EmployeeIdFilter" />
                                                <input type="hidden" name="ReturnPosition" value="@Model.PositionFilter" />
                                                <input type="hidden" name="ReturnEmploymentType" value="@Model.EmploymentTypeFilter" />
                                                <input type="hidden" name="IsReset" value="true" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="Đặt lại theo hệ thống" onclick="return confirm('Đặt lại giờ công theo hệ thống tính toán?');">
                                                    <i class="fa-solid fa-rotate-left"></i> Đặt lại
                                                </button>
                                            </form>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-25 text-muted"><i class="fa-solid fa-hourglass-half me-1"></i>Chưa kết thúc ca</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
