@using ShiftScheduling.Models.Enums
@model ShiftScheduling.Features.Reports.ViewModels.EmployeeWorkReportOverviewViewModel
@{
    ViewData["Title"] = "Báo cáo ca của tôi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="fa-solid fa-chart-pie text-primary me-2"></i>Báo cáo ca của tôi</h3>
        <p class="text-muted small mb-0">Theo dõi số ca, số ngày và tổng thời gian làm việc theo từng kỳ.</p>
    </div>
</div>

<div class="card card-custom border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="MyReport" class="row g-2 align-items-center">
            <div class="col-auto">
                <label class="form-label small fw-bold mb-0 text-dark d-flex align-items-center gap-1">
                    <i class="fa-regular fa-calendar-days text-primary"></i>
                    <span>Kỳ lịch:</span>
                </label>
            </div>
            <div class="col-sm-6 col-md-5 col-lg-4">
                <select name="schedulePeriodId" class="form-select form-select-sm" onchange="this.form.submit()">
                    @if (!Model.PeriodOptions.Any())
                    {
                        <option value="">-- Chưa có kỳ lịch công bố --</option>
                    }
                    @foreach (var opt in Model.PeriodOptions)
                    {
                        <option value="@opt.SchedulePeriodId" selected="@(opt.SchedulePeriodId == Model.SchedulePeriodId ? "selected" : null)">
                            @opt.PeriodName
                        </option>
                    }
                </select>
            </div>
            @if (Model.SchedulePeriodId > 0 && !string.IsNullOrEmpty(Model.PeriodName))
            {
                <div class="col-auto ms-sm-auto text-muted small">
                    <span class="badge badge-custom badge-primary-custom px-3 py-2">
                        <i class="fa-regular fa-clock me-1"></i>
                        @Model.WeekStartDate.ToString("dd/MM/yyyy") - @Model.WeekEndDate.ToString("dd/MM/yyyy")
                    </span>
                </div>
            }
        </form>
    </div>
</div>

@if (Model.Summary is null)
{
    <div class="card card-custom border-0 shadow-sm text-center py-5">
        <div class="card-body">
            <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle mb-3" style="width: 56px; height: 56px;">
                <i class="fa-regular fa-folder-open fa-2x text-muted"></i>
            </div>
            <h5 class="fw-bold text-secondary">Chưa có dữ liệu tổng hợp</h5>
            <p class="text-muted mb-0">Bạn chưa được phân ca trong kỳ lịch chính thức đã chọn.</p>
        </div>
    </div>
}
else
{
    var formattedHours = Model.Summary.TotalHours % 1 == 0
        ? decimal.ToInt32(Model.Summary.TotalHours).ToString()
        : Model.Summary.TotalHours.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    var isFullTime = Model.Summary.EmploymentType == EmploymentType.FullTime;
    var targetUnits = isFullTime ? 6 : 5;
    var actualUnits = isFullTime ? Model.Summary.TotalWorkDays : Model.Summary.TotalShifts;
    var progressPercent = targetUnits > 0
        ? Math.Min(100, Math.Max(0, (int)Math.Round((double)actualUnits / targetUnits * 100)))
        : 0;

    <!-- Các thẻ số liệu tổng hợp -->
    <div class="row g-3 g-md-4 mb-4">
        <!-- Metric 1: Tổng số ca (Indigo) -->
        <div class="col-md-4">
            <div class="card card-custom report-stat-card report-stat-card-indigo h-100">
                <div class="card-body p-3 p-md-4 d-flex align-items-center gap-3">
                    <div class="report-stat-icon-box">
                        <i class="fa-solid fa-briefcase"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">Tổng số ca</div>
                        <div class="fs-3 fw-bold report-stat-value font-monospace">
                            @Model.Summary.TotalShifts <span class="fs-6 fw-normal text-muted">ca</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Metric 2: Ngày làm (Teal) -->
        <div class="col-md-4">
            <div class="card card-custom report-stat-card report-stat-card-teal h-100">
                <div class="card-body p-3 p-md-4 d-flex align-items-center gap-3">
                    <div class="report-stat-icon-box">
                        <i class="fa-regular fa-calendar-check"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">Ngày làm</div>
                        <div class="fs-3 fw-bold report-stat-value font-monospace">
                            @Model.Summary.TotalWorkDays <span class="fs-6 fw-normal text-muted">ngày</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Metric 3: Tổng thời gian (Cyan) -->
        <div class="col-md-4">
            <div class="card card-custom report-stat-card report-stat-card-cyan h-100">
                <div class="card-body p-3 p-md-4 d-flex align-items-center gap-3">
                    <div class="report-stat-icon-box">
                        <i class="fa-regular fa-clock"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">Tổng thời gian</div>
                        <div class="fs-3 fw-bold report-stat-value font-monospace">
                            @formattedHours <span class="fs-6 fw-normal text-muted">giờ</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Thẻ định mức làm việc -->
    <div class="card card-custom border-0 shadow-sm">
        <div class="card-header-custom py-3 px-4 d-flex justify-content-between align-items-center">
            <span class="fw-bold d-flex align-items-center gap-2">
                <div class="card-header-icon-pill">
                    <i class="fa-solid fa-chart-simple"></i>
                </div>
                <span>Mức làm việc trong kỳ</span>
            </span>
            <span class="badge badge-custom badge-primary-custom px-3 py-1 fw-semibold">
                <i class="fa-solid @(isFullTime ? "fa-user-tie" : "fa-user-clock") me-1"></i>@(isFullTime ? "Toàn thời gian (FT)" : "Bán thời gian (PT)")
            </span>
        </div>
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-baseline mb-2">
                <div>
                    <span class="fs-4 fw-bold text-dark font-monospace">
                        @(isFullTime ? $"{Model.Summary.TotalWorkDays} / 6 ngày" : $"{Model.Summary.TotalShifts} / 5 ca")
                    </span>
                </div>
                <div class="text-muted small">
                    @(isFullTime ? "Mức dự kiến: 6 ngày" : "Mức dự kiến: 5 ca")
                </div>
            </div>
            <div class="progress progress-custom mb-2">
                <div class="progress-bar progress-bar-purple"
                     role="progressbar"
                     style="width: @progressPercent%;"
                     aria-valuenow="@progressPercent"
                     aria-valuemin="0"
                     aria-valuemax="100"></div>
            </div>
            <div class="d-flex justify-content-between align-items-center text-muted small mt-2">
                <span>Tiến độ hoàn thành: <strong class="text-primary font-monospace">@progressPercent%</strong></span>
                <span>@(isFullTime ? "Chỉ tiêu chuẩn: 6 ngày/tuần" : "Chỉ tiêu chuẩn: 5 ca/tuần")</span>
            </div>
        </div>
    </div>
}
