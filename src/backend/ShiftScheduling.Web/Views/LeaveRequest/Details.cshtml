@model ShiftScheduling.Features.LeaveRequests.ViewModels.LeaveRequestDetailsViewModel

@{
    ViewData["Title"] = "Chi tiết đơn xin nghỉ";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Chi tiết đơn xin nghỉ</h1>
        <p class="page-subtitle">Thông tin mới nhất của đơn #@Model.LeaveRequestId.</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary-custom">Quay lại</a>
</div>

<div class="card-custom">
    <div class="card-header-custom d-flex justify-content-between align-items-center">
        <span>@Model.EmployeeName (@Model.EmployeeCode)</span>
        @if (Model.Status == LeaveRequestStatus.Pending)
        {
            <span class="badge badge-custom badge-pending">Chờ duyệt</span>
        }
        else if (Model.Status == LeaveRequestStatus.Approved)
        {
            <span class="badge badge-custom badge-active">Đã duyệt</span>
        }
        else if (Model.Status == LeaveRequestStatus.Cancelled)
        {
            <span class="badge badge-custom badge-secondary">Đã hủy</span>
        }
        else
        {
            <span class="badge badge-custom badge-rejected">Từ chối</span>
        }
    </div>
    <div class="p-4">
        <dl class="row mb-0">
            <dt class="col-sm-3">Kỳ lịch</dt>
            <dd class="col-sm-9">@Model.PeriodName</dd>
            <dt class="col-sm-3">Ngày nghỉ</dt>
            <dd class="col-sm-9">@Model.LeaveDate.ToString("dd/MM/yyyy")</dd>
            <dt class="col-sm-3">Ca</dt>
            <dd class="col-sm-9">@Model.ShiftName</dd>
            <dt class="col-sm-3">Lý do</dt>
            <dd class="col-sm-9">@Model.Reason</dd>
            <dt class="col-sm-3">Thời điểm gửi</dt>
            <dd class="col-sm-9">@Model.SubmittedAt.ToString("dd/MM/yyyy HH:mm")</dd>
            <dt class="col-sm-3">Ghi chú Quản lý</dt>
            <dd class="col-sm-9">@(Model.ManagerNote ?? "—")</dd>
        </dl>

        @if (Model.NeedsReplacement)
        {
            <div class="alert alert-custom alert-custom-warning mt-4 mb-0">
                <i class="fa-solid fa-triangle-exclamation"></i>
                <div>
                    <div class="fw-semibold">Đã duyệt — Chưa bố trí người thay</div>
                    <span>
                        Nhân viên vẫn đang được ghi nhận trong ca làm việc đã công bố.
                        Hãy bố trí người thay để cập nhật lịch.
                    </span>
                </div>
            </div>
            <div class="mt-3">
                <a asp-controller="WorkSchedule"
                   asp-action="LeaveReplacement"
                   asp-route-leaveRequestId="@Model.LeaveRequestId"
                   class="btn btn-primary-custom">
                    <i class="fa-solid fa-user-clock me-1"></i>
                    Tìm người thay
                </a>
            </div>
        }
        else if (Model.ReplacementHandled)
        {
            <div class="alert alert-custom alert-custom-success mt-4 mb-0">
                <i class="fa-solid fa-circle-check"></i>
                <div>
                    <div class="fw-semibold">Đã duyệt — Đã xử lý phân công</div>
                    <span>Ca làm việc bị ảnh hưởng bởi đơn nghỉ đã được cập nhật trên lịch đã công bố.</span>
                </div>
            </div>
            @if (Model.SchedulePeriodId > 0)
            {
                <div class="mt-3">
                    <a asp-controller="WorkSchedule"
                       asp-action="Edit"
                       asp-route-id="@Model.SchedulePeriodId"
                       class="btn btn-secondary-custom">
                        <i class="fa-solid fa-calendar-check me-1"></i>
                        Xem lịch đã cập nhật
                    </a>
                </div>
            }
        }
        else if (!Model.IsManager && Model.Status == LeaveRequestStatus.Approved)
        {
            <div class="alert alert-custom alert-custom-success mt-4 mb-0">
                <i class="fa-solid fa-circle-check"></i>
                <div>
                    <span>Đơn xin nghỉ đã được duyệt.</span>
                </div>
            </div>
        }
        else if (Model.IsManager && Model.HasPublishedAssignment && Model.Status == LeaveRequestStatus.Pending)
        {
            <div class="alert alert-custom alert-custom-warning mt-4 mb-0">
                <i class="fa-solid fa-triangle-exclamation"></i>
                <div>
                    <span>Nếu duyệt đơn này, lịch chính thức hiện tại sẽ có ca cần được điều chỉnh.</span>
                </div>
            </div>
        }

        @if (Model.CanReview)
        {
            <div class="mt-4">
                <a asp-action="Review"
                   asp-route-id="@Model.LeaveRequestId"
                   class="btn btn-primary-custom">
                    Xử lý đơn
                </a>
            </div>
        }

        @if (Model.CanCancel)
        {
            <div class="mt-4">
                <form asp-action="Cancel"
                      asp-route-id="@Model.LeaveRequestId"
                      method="post"
                      class="d-inline"
                      onsubmit="return confirm('Bạn có chắc muốn hủy đơn xin nghỉ này không?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="fa-solid fa-ban"></i> Hủy đơn
                    </button>
                </form>
            </div>
        }
    </div>
</div>
