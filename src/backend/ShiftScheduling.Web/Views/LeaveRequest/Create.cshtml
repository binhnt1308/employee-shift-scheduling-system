@model ShiftScheduling.Features.LeaveRequests.ViewModels.LeaveRequestCreateViewModel

@{
    ViewData["Title"] = "Gửi đơn xin nghỉ";
    var hasEligiblePeriods = Model.Periods.Count > 0;
}

<div class="page-header">
    <div>
        <h1 class="page-title">Gửi đơn xin nghỉ</h1>
        <p class="page-subtitle">Chọn ngày hoặc ca cần nghỉ trong kỳ lịch đã được phân công chính thức.</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary-custom">Quay lại</a>
</div>

<div class="card-custom">
    <div class="card-header-custom">Thông tin đơn xin nghỉ</div>
    <div class="p-4">
        @if (!hasEligiblePeriods)
        {
            <div class="alert alert-custom alert-custom-warning mb-0">
                <i class="fa-solid fa-triangle-exclamation"></i>
                <div>
                    <strong>Chưa có ca làm việc khả dụng</strong>
                    <div>Bạn chưa có ca làm việc nào trong các kỳ lịch đã công bố. Đơn xin nghỉ chỉ có thể gửi khi bạn đã được phân công ca trong lịch chính thức.</div>
                </div>
            </div>
        }
        else
        {
            <form asp-action="Create" method="post" data-prevent-double-submit="true">
                <div asp-validation-summary="ModelOnly" class="alert alert-custom alert-custom-danger"></div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label asp-for="SchedulePeriodId" class="form-label fw-semibold"></label>
                        <select asp-for="SchedulePeriodId" id="periodSelect" class="form-select form-select-custom">
                            @foreach (var period in Model.Periods)
                            {
                                <option value="@period.SchedulePeriodId">
                                    @period.PeriodName (@period.WeekStartDate.ToString("dd/MM") - @period.WeekEndDate.ToString("dd/MM/yyyy"))
                                </option>
                            }
                        </select>
                        <span asp-validation-for="SchedulePeriodId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LeaveDate" class="form-label fw-semibold"></label>
                        <select asp-for="LeaveDate" id="dateSelect" class="form-select form-select-custom">
                            @foreach (var date in Model.AvailableDates)
                            {
                                <option value="@date.ToString("yyyy-MM-dd")" selected="@(date == Model.LeaveDate ? "selected" : null)">
                                    @date.ToString("dd/MM/yyyy")
                                </option>
                            }
                        </select>
                        <span asp-validation-for="LeaveDate" class="text-danger small"></span>
                        <span class="form-text">Chỉ hiển thị các ngày bạn có ca làm việc được phân công.</span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ShiftTypeId" class="form-label fw-semibold"></label>
                        <select asp-for="ShiftTypeId" id="shiftSelect" class="form-select form-select-custom">
                            <option value="">Cả ngày (nghỉ mọi ca trong ngày)</option>
                            @foreach (var shift in Model.ShiftTypes)
                            {
                                <option value="@shift.ShiftTypeId" selected="@(shift.ShiftTypeId == Model.ShiftTypeId ? "selected" : null)">
                                    @shift.ShiftName (@shift.StartTime.ToString("HH:mm") - @shift.EndTime.ToString("HH:mm"))
                                </option>
                            }
                        </select>
                        <span asp-validation-for="ShiftTypeId" class="text-danger small"></span>
                        <span class="form-text">Chỉ hiển thị các ca bạn được phân công trong ngày này.</span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Reason" class="form-label fw-semibold"></label>
                        <textarea asp-for="Reason"
                                  rows="4"
                                  class="form-control form-control-custom"
                                  placeholder="Nhập lý do xin nghỉ..."></textarea>
                        <span asp-validation-for="Reason" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-secondary-custom">Hủy</a>
                    <button type="submit" class="btn btn-primary-custom">
                        <i class="fa-solid fa-paper-plane"></i>
                        Gửi đơn
                    </button>
                </div>
            </form>
        }
    </div>
</div>

@if (hasEligiblePeriods)
{
    @section Scripts {
        <script>
            (function () {
                const assignments = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AvailableAssignments));
                const periodSelect = document.getElementById('periodSelect');
                const dateSelect = document.getElementById('dateSelect');
                const shiftSelect = document.getElementById('shiftSelect');

                if (!periodSelect || !dateSelect || !shiftSelect) return;

                function getAssignedDatesForPeriod(periodId) {
                    const filtered = assignments.filter(a => a.SchedulePeriodId === Number(periodId));
                    const uniqueDates = [...new Set(filtered.map(a => a.WorkDate))];
                    uniqueDates.sort();
                    return uniqueDates;
                }

                function getAssignedShiftsForDate(periodId, dateStr) {
                    return assignments.filter(a => a.SchedulePeriodId === Number(periodId) && a.WorkDate === dateStr);
                }

                function formatDateDisplay(isoDate) {
                    if (!isoDate) return '';
                    const parts = isoDate.split('-');
                    if (parts.length === 3) {
                        return parts[2] + '/' + parts[1] + '/' + parts[0];
                    }
                    return isoDate;
                }

                function updateDates() {
                    const periodId = periodSelect.value;
                    const dates = getAssignedDatesForPeriod(periodId);
                    const currentSelectedDate = dateSelect.value;

                    dateSelect.innerHTML = '';
                    dates.forEach(d => {
                        const opt = document.createElement('option');
                        opt.value = d;
                        opt.textContent = formatDateDisplay(d);
                        if (d === currentSelectedDate) {
                            opt.selected = true;
                        }
                        dateSelect.appendChild(opt);
                    });

                    if (!dates.includes(currentSelectedDate) && dates.length > 0) {
                        dateSelect.value = dates[0];
                    }
                    updateShifts();
                }

                function updateShifts() {
                    const periodId = periodSelect.value;
                    const selectedDate = dateSelect.value;
                    const shifts = getAssignedShiftsForDate(periodId, selectedDate);
                    const currentSelectedShift = shiftSelect.value;

                    shiftSelect.innerHTML = '<option value="">Cả ngày (nghỉ mọi ca trong ngày)</option>';
                    shifts.forEach(s => {
                        const opt = document.createElement('option');
                        opt.value = s.ShiftTypeId;
                        const startTime = typeof s.StartTime === 'string' ? s.StartTime.substring(0, 5) : s.StartTime;
                        const endTime = typeof s.EndTime === 'string' ? s.EndTime.substring(0, 5) : s.EndTime;
                        opt.textContent = s.ShiftName + ' (' + startTime + ' - ' + endTime + ')';
                        if (String(s.ShiftTypeId) === String(currentSelectedShift)) {
                            opt.selected = true;
                        }
                        shiftSelect.appendChild(opt);
                    });
                }

                periodSelect.addEventListener('change', updateDates);
                dateSelect.addEventListener('change', updateShifts);
            })();
        </script>
    }
}
