@using ShiftScheduling.Common.Time
@model ShiftScheduling.Features.WorkSchedules.ViewModels.WorkScheduleEditViewModel
@{
    ViewData["Title"] = "Phân công ca - " + Model.PeriodName;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="fa-solid fa-calendar-week text-primary me-2"></i>@Model.PeriodName</h3>
        <p class="text-muted small mb-0">
            Tuần: @Model.WeekStartDate.ToString("dd/MM/yyyy") - @Model.WeekEndDate.ToString("dd/MM/yyyy") | 
            Trạng thái: 
            @if (Model.Status == ShiftScheduling.Models.Enums.ScheduleStatus.Published)
            {
                <span class="badge bg-success">ĐÃ CÔNG BỐ</span>
            }
            else
            {
                <span class="badge bg-warning text-dark">BẢN NHÁP</span>
            }
            @if (Model.IsGeneratedByORTools)
            {
                <span class="badge bg-info text-dark ms-1"><i class="fa-solid fa-robot me-1"></i>Từ OR-Tools</span>
            }
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="fa-solid fa-arrow-left me-1"></i>Quay lại</a>
        @if (Model.Status != ShiftScheduling.Models.Enums.ScheduleStatus.Published)
        {
            <form method="post" asp-action="SaveDraft" asp-route-id="@Model.SchedulePeriodId" class="d-inline" data-prevent-double-submit="true">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-primary"><i class="fa-solid fa-floppy-disk me-1"></i>Lưu nháp</button>
            </form>
            <button type="button" class="btn btn-outline-info text-dark" onclick="generateOrToolsProposal(this)"><i class="fa-solid fa-wand-magic-sparkles me-1"></i>Sinh lịch OR-Tools</button>
            <form method="post" asp-action="Publish" asp-route-id="@Model.SchedulePeriodId" class="d-inline" data-prevent-double-submit="true">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success" @(!Model.ValidationResult.IsValid ? "disabled" : "") onclick="return confirm('Xác nhận công bố chính thức lịch làm việc này cho nhân viên?');">
                    <i class="fa-solid fa-paper-plane me-1"></i>Công bố lịch
                </button>
            </form>
        }
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-circle-exclamation me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Status == ShiftScheduling.Models.Enums.ScheduleStatus.Published)
{
    <div class="alert alert-info border-0 shadow-sm d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center">
            <i class="fa-solid fa-circle-info fs-4 me-3 text-info"></i>
            <div>
                <div class="fw-semibold">Lịch này đã được công bố nên không thể chỉnh phân công trực tiếp.</div>
                <div class="small text-muted">
                    Nếu nhân viên có đơn nghỉ đã được duyệt, hãy xử lý người thay tại chức năng Đơn xin nghỉ.
                </div>
            </div>
        </div>
        <a asp-controller="LeaveRequest" asp-action="Index" class="btn btn-sm btn-outline-primary ms-3 text-nowrap">
            <i class="fa-solid fa-calendar-minus me-1"></i>Đến Đơn xin nghỉ
        </a>
    </div>
}

<!-- BANNER KIỂM TRA RÀNG BUỘC -->
<div class="row mb-4">
    <div class="col-md-7">
        @if (Model.ValidationResult.HardErrors.Any())
        {
            <div class="alert alert-danger border-0 shadow-sm mb-0">
                <h6 class="fw-bold mb-2"><i class="fa-solid fa-circle-xmark me-2"></i>Vi phạm bắt buộc (Không được công bố): (@Model.ValidationResult.HardErrors.Count)</h6>
                <ul class="mb-0 small ps-3">
                    @foreach (var err in Model.ValidationResult.HardErrors)
                    {
                        <li>@err</li>
                    }
                </ul>
            </div>
        }
        else
        {
            <div class="alert alert-success border-0 shadow-sm mb-0">
                <i class="fa-solid fa-circle-check me-2"></i><strong>Hợp lệ:</strong> Lịch làm việc thỏa mãn toàn bộ các ràng buộc bắt buộc và đã đủ điều kiện để công bố.
            </div>
        }
    </div>
    <div class="col-md-5">
        @if (Model.ValidationResult.Warnings.Any())
        {
            <div class="alert alert-warning border-0 shadow-sm mb-0">
                <h6 class="fw-bold mb-2"><i class="fa-solid fa-triangle-exclamation me-2"></i>Cảnh báo ưu tiên: (@Model.ValidationResult.Warnings.Count)</h6>
                <ul class="mb-0 small ps-3">
                    @foreach (var warn in Model.ValidationResult.Warnings)
                    {
                        <li>@warn</li>
                    }
                </ul>
            </div>
        }
        else
        {
            <div class="alert alert-light border shadow-sm mb-0">
                <i class="fa-solid fa-info-circle me-2 text-info"></i>Không có cảnh báo chênh lệch khối lượng công việc.
            </div>
        }
    </div>
</div>

<!-- BANG PHAN CONG 7x3 -->
<div class="card card-custom border-0 shadow-sm mb-4">
    <div class="card-header bg-light py-3 fw-bold d-flex justify-content-between align-items-center">
        <span><i class="fa-solid fa-table me-2"></i>Bảng phân công ca làm việc (7 ngày x 3 ca cố định)</span>
    </div>
    <div class="card-body p-0">
        <div class="px-3 py-2 bg-light border-bottom d-flex flex-wrap align-items-center gap-3 small text-muted">
            <span class="fw-semibold text-dark"><i class="fa-solid fa-circle-info text-primary me-1"></i>Chú thích:</span>
            <span><span class="text-warning fw-bold">★</span> Nguyện vọng ưu tiên</span>
            <span class="d-inline-flex align-items-center gap-1"><span class="legend-swatch legend-swatch-sales"></span> Tư vấn</span>
            <span class="d-inline-flex align-items-center gap-1"><span class="legend-swatch legend-swatch-cashier"></span> Thu ngân</span>
        </div>
        <div class="table-responsive">
            <table class="table table-bordered align-middle mb-0">
                <thead class="table-light text-center">
                    <tr>
                        <th style="width: 140px; min-width: 140px;">Ca làm việc</th>
                        @foreach (var day in Model.Days)
                        {
                            <th style="min-width: 220px;">
                                <div class="fw-bold">@day.WorkDate.DayOfWeek.ToShortVietnameseDay()</div>
                                <div class="text-muted small">@day.WorkDate.ToString("dd/MM")</div>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @{
                        var shiftTemplates = Model.Days.FirstOrDefault()?.Shifts ?? new();
                    }
                    @foreach (var st in shiftTemplates)
                    {
                        <tr class="calendar-shift-row @(st.ShiftTypeId == 2 ? "manager-calendar-afternoon" : "")">
                            <td class="calendar-shift-title-cell fw-semibold">
                                <div class="fw-bold">@st.ShiftName</div>
                                <div class="text-muted small">@st.StartTime.ToString("HH:mm")–@st.EndTime.ToString("HH:mm")</div>
                            </td>
                            @foreach (var day in Model.Days)
                            {
                                var shift = day.Shifts.FirstOrDefault(s => s.ShiftTypeId == st.ShiftTypeId);
                                <td class="calendar-cell">
                                    @if (shift != null)
                                    {
                                        var totalReq = shift.RequiredSales + shift.RequiredCashier;
                                        var totalAssigned = shift.AssignedSales + shift.AssignedCashier;
                                        var missingCount = shift.MissingSales + shift.MissingCashier;
                                        var isSalesMissing = shift.AssignedSales < shift.RequiredSales;
                                        var isCashierMissing = shift.AssignedCashier < shift.RequiredCashier;
                                        var l2Text = shift.HasLevel2Plus ? "Có" : "Thiếu";
                                        var staffingTooltip = $"Tư vấn: {shift.AssignedSales}/{shift.RequiredSales}&#10;Thu ngân: {shift.AssignedCashier}/{shift.RequiredCashier}&#10;Nhân viên II+: {l2Text}";

                                        <div class="calendar-cell-header">
                                            @if (shift.IsSatisfied)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle fw-semibold" tabindex="0" title="@Html.Raw(staffingTooltip)">
                                                    <i class="fa-solid fa-check me-1"></i>Đủ @totalAssigned/@totalReq
                                                </span>
                                            }
                                            else if (missingCount > 0)
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-semibold" tabindex="0" title="@Html.Raw(staffingTooltip)">
                                                    <i class="fa-solid fa-triangle-exclamation me-1"></i>Thiếu @missingCount · @totalAssigned/@totalReq
                                                </span>
                                            }
                                            else if (!shift.HasLevel2Plus)
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-semibold" tabindex="0" title="@Html.Raw(staffingTooltip)">
                                                    <i class="fa-solid fa-triangle-exclamation me-1"></i>Thiếu II+ · @totalAssigned/@totalReq
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle fw-semibold" tabindex="0" title="@Html.Raw(staffingTooltip)">
                                                    <i class="fa-solid fa-triangle-exclamation me-1"></i>Vượt · @totalAssigned/@totalReq
                                                </span>
                                            }

                                            <div class="d-inline-flex align-items-center gap-2 small" tabindex="0" title="@Html.Raw(staffingTooltip)">
                                                <span class="d-inline-flex align-items-center @(isSalesMissing ? "text-danger fw-bold" : "text-secondary")" title="Tư vấn: @shift.AssignedSales/@shift.RequiredSales">
                                                    <i class="fa-solid fa-user text-primary me-1" aria-label="Tư vấn"></i>@(isSalesMissing ? $"{shift.AssignedSales}/{shift.RequiredSales}" : $"{shift.AssignedSales}")
                                                </span>
                                                <span class="d-inline-flex align-items-center @(isCashierMissing ? "text-danger fw-bold" : "text-secondary")" title="Thu ngân: @shift.AssignedCashier/@shift.RequiredCashier">
                                                    <i class="fa-solid fa-cash-register text-success me-1" aria-label="Thu ngân"></i>@(isCashierMissing ? $"{shift.AssignedCashier}/{shift.RequiredCashier}" : $"{shift.AssignedCashier}")
                                                </span>
                                            </div>
                                        </div>

                                        <div class="calendar-chips-container my-1">
                                            @foreach (var emp in shift.AssignedEmployees)
                                            {
                                                var posClass = emp.Position == ShiftScheduling.Models.Enums.EmployeePosition.Sales ? "employee-chip-sales" : "employee-chip-cashier";
                                                var posName = emp.Position == ShiftScheduling.Models.Enums.EmployeePosition.Sales ? "Tư vấn" : "Thu ngân";
                                                var levelName = emp.Level switch
                                                {
                                                    ShiftScheduling.Models.Enums.EmployeeLevel.Level1 => "I",
                                                    ShiftScheduling.Models.Enums.EmployeeLevel.Level2 => "II",
                                                    ShiftScheduling.Models.Enums.EmployeeLevel.Level3 => "III",
                                                    _ => emp.Level.ToString()
                                                };
                                                var prefText = emp.IsPreferred ? "★ Nguyện vọng ưu tiên" : "Nguyện vọng bình thường";
                                                var tooltipText = $"{emp.EmployeeCode} - {emp.FullName}&#10;{posName}&#10;{levelName}&#10;{prefText}";

                                                <span class="employee-chip @posClass" tabindex="0" title="@Html.Raw(tooltipText)">
                                                    @if (emp.IsPreferred)
                                                    {
                                                        <span class="chip-star">★</span>
                                                    }
                                                    <span>@emp.EmployeeCode</span>
                                                    @if (Model.Status != ShiftScheduling.Models.Enums.ScheduleStatus.Published)
                                                    {
                                                        <button type="button" class="btn btn-link text-danger p-0 ms-1 border-0" style="font-size: 0.7rem; line-height: 1;" onclick="removeEmployee(@Model.SchedulePeriodId, @emp.ShiftAssignmentId, this)" title="Xóa phân công @emp.EmployeeCode">
                                                            <i class="fa-solid fa-xmark"></i>
                                                        </button>
                                                    }
                                                </span>
                                                @if (emp.HasApprovedLeave && emp.ApprovedLeaveRequestId.HasValue)
                                                {
                                                    <span class="badge bg-warning text-dark"
                                                          style="font-size: 0.65rem;"
                                                          title="Đã duyệt nghỉ">
                                                        <i class="fa-solid fa-calendar-xmark me-1"></i>
                                                        Nghỉ đã duyệt
                                                    </span>
                                                    <a asp-controller="LeaveRequest"
                                                       asp-action="Details"
                                                       asp-route-id="@emp.ApprovedLeaveRequestId.Value"
                                                       class="btn btn-outline-warning text-dark"
                                                       style="font-size: 0.65rem; padding: 0 4px;"
                                                       title="Xử lý người thay">
                                                        <i class="fa-solid fa-user-clock me-1"></i>
                                                        Xử lý người thay
                                                    </a>
                                                }
                                            }
                                        </div>

                                        @if (Model.Status != ShiftScheduling.Models.Enums.ScheduleStatus.Published)
                                        {
                                            <button type="button" class="btn btn-xs btn-outline-primary w-100 py-1 mt-1" onclick="openAssignModal(@Model.SchedulePeriodId, '@shift.WorkDate.ToString("yyyy-MM-dd")', @shift.ShiftTypeId, '@day.DayOfWeekName - @shift.ShiftName')">
                                                <i class="fa-solid fa-plus me-1"></i>Thêm
                                            </button>
                                        }
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL THÊM PHÂN CÔNG THỦ CÔNG -->
<div class="modal fade" id="assignModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="assignModalTitle">Phân công nhân viên</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="assignModalAlert" class="alert alert-danger d-none"></div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Chọn nhân viên phù hợp</label>
                    <select id="assignEmployeeSelect" class="form-select">
                        <option value="">-- Đang tải nhân viên rảnh --</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary-custom" onclick="submitManualAssign(this)">Phân công</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL XEM TRƯỚC LỊCH ĐỀ XUẤT OR-TOOLS -->
<div class="modal fade" id="orToolsModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-robot me-2"></i>Kết quả sinh lịch đề xuất tự động (Google OR-Tools)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="orToolsLoading" class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 text-muted fw-semibold">Google OR-Tools CP-SAT đang giải bài toán lập lịch...</p>
                </div>
                <div id="orToolsContent" class="d-none">
                    <div id="orToolsStatusBanner" class="alert alert-success mb-3"></div>
                    <div class="card card-custom mb-3">
                        <div class="card-header bg-light py-2 fw-bold small">Danh sách lượt phân công đề xuất</div>
                        <div class="card-body p-0" style="max-height: 300px; overflow-y: auto;">
                            <table class="table table-sm table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Ngày</th>
                                        <th>Ca</th>
                                        <th>Nhân viên</th>
                                        <th>Vị trí</th>
                                    </tr>
                                </thead>
                                <tbody id="orToolsTableBody"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer d-none" id="orToolsFooter">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Bỏ đề xuất</button>
                <button type="button" class="btn btn-success" onclick="adoptOrToolsProposal(this)"><i class="fa-solid fa-check me-1"></i>Sử dụng đề xuất này</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_EditScripts", Model)
}
