@using ShiftScheduling.Common.Time
@model ShiftScheduling.Features.WorkSchedules.ViewModels.WorkScheduleEditViewModel
@{
    ViewData["Title"] = "Lịch làm việc của tôi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="fa-solid fa-calendar-user text-primary me-2"></i>Lịch làm việc của tôi</h3>
        <p class="text-muted small mb-0">Xem lịch làm việc chính thức đã được Quản lý công bố</p>
    </div>
</div>

@if (Model is null)
{
    <div class="card card-custom border-0 shadow-sm text-center py-5">
        <div class="card-body">
            <i class="fa-solid fa-calendar-xmark fa-3x text-muted mb-3"></i>
            <h5 class="fw-bold text-secondary">Chưa có lịch chính thức</h5>
            <p class="text-muted mb-0">Hiện chưa có kỳ lịch nào được Quản lý công bố chính thức cho bạn.</p>
        </div>
    </div>
}
else
{
    @if (Model.PeriodOptions.Any())
    {
        <div class="card card-custom border-0 shadow-sm mb-4">
            <div class="card-body p-3">
                <form method="get" asp-action="Index" class="row g-2 align-items-center">
                    <div class="col-auto">
                        <label class="form-label small fw-bold mb-0 text-dark d-flex align-items-center gap-1">
                            <i class="fa-regular fa-calendar-days text-primary"></i>
                            <span>Kỳ lịch:</span>
                        </label>
                    </div>
                    <div class="col-sm-6 col-md-5 col-lg-4">
                        <select name="id" class="form-select form-select-sm" onchange="this.form.submit()">
                            @foreach (var opt in Model.PeriodOptions)
                            {
                                <option value="@opt.SchedulePeriodId" selected="@(opt.SchedulePeriodId == Model.SchedulePeriodId ? "selected" : null)">
                                    @opt.DisplayText
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-auto ms-sm-auto text-muted small">
                        <span class="badge badge-custom @Model.DisplayBadgeClass px-3 py-2">
                            <i class="fa-regular fa-clock me-1"></i>
                            @Model.EffectiveStatusName
                        </span>
                    </div>
                </form>
            </div>
        </div>
    }

    <div class="card card-custom border-0 shadow-sm mb-4">
        <div class="card-header bg-light py-3 fw-bold d-flex justify-content-between align-items-center">
            <div>
                <i class="fa-solid fa-calendar-week me-2"></i>@Model.PeriodName (@Model.WeekStartDate.ToString("dd/MM/yyyy") - @Model.WeekEndDate.ToString("dd/MM/yyyy"))
            </div>
            <span class="badge badge-custom @Model.DisplayBadgeClass">
                @Model.EffectiveStatusName
            </span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0">
                    <thead class="table-light text-center">
                        <tr>
                            <th style="width: 140px; min-width: 140px;">Ca làm việc</th>
                            @foreach (var day in Model.Days)
                            {
                                <th style="min-width: 150px;">
                                    <div class="fw-bold">@day.WorkDate.DayOfWeek.ToShortVietnameseDay()</div>
                                    <div class="text-muted small">@day.WorkDate.ToString("dd/MM")</div>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var shiftTemplates = Model.Days.FirstOrDefault()?.Shifts ?? new();
                        }
                        @foreach (var st in shiftTemplates)
                        {
                            <tr>
                                <td class="fw-semibold bg-light bg-opacity-50 text-center align-middle">
                                    <div class="fw-bold">@st.ShiftName</div>
                                    <div class="text-muted small">@st.StartTime.ToString("HH:mm")–@st.EndTime.ToString("HH:mm")</div>
                                </td>
                                @foreach (var day in Model.Days)
                                {
                                    var shift = day.Shifts.FirstOrDefault(s => s.ShiftTypeId == st.ShiftTypeId);
                                    <td class="align-middle p-3 text-center" style="min-width: 150px;">
                                        @if (shift != null && shift.AssignedEmployees.Any())
                                        {
                                            var myAssignment = shift.AssignedEmployees.First();
                                            @if (myAssignment.HasApprovedLeave)
                                            {
                                                <div class="p-2 rounded bg-warning bg-opacity-25 border border-warning text-dark fw-bold" title="Ca làm việc đã được duyệt nghỉ">
                                                    <i class="fa-solid fa-calendar-xmark me-1 text-warning"></i>Nghỉ đã duyệt
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="p-2 rounded bg-success bg-opacity-10 border border-success text-success fw-bold">
                                                    <i class="fa-solid fa-circle-check me-1"></i>Được phân công
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="text-muted small italic py-2">- Không có ca -</div>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
