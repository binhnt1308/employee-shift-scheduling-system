@model AccountIndexViewModel
@{
    ViewData["Title"] = "Quản lý tài khoản";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Quản lý tài khoản người dùng</h1>
        <p class="page-subtitle">
            Tạo tài khoản, phân quyền, khóa/mở khóa và đặt lại mật khẩu
        </p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary-custom">
            <i class="fa-solid fa-user-plus me-1"></i>
            Tạo tài khoản mới
        </a>
    </div>
</div>

<div class="card card-custom mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md">
                <input asp-for="Keyword"
                       class="form-control form-control-custom"
                       placeholder="Tìm theo tên đăng nhập, mã hoặc tên nhân viên..." />
            </div>
            <div class="col-md-auto">
                <button class="btn btn-secondary-custom" type="submit">
                    <i class="fa-solid fa-magnifying-glass me-1"></i>
                    Tìm kiếm
                </button>
                <a asp-action="Index" class="btn btn-light border">Xóa lọc</a>
            </div>
        </form>
    </div>
</div>

<div class="card card-custom p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-custom align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-4">Tài khoản</th>
                    <th>Vai trò</th>
                    <th>Nhân viên liên kết</th>
                    <th>Người tạo</th>
                    <th>Trạng thái</th>
                    <th class="text-end pe-4">Thao tác</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Accounts.Items.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-center py-5 text-muted">
                        Chưa có tài khoản phù hợp.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var account in Model.Accounts.Items)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="fw-bold text-dark font-monospace">
                                <i class="fa-solid fa-circle-user text-primary me-2"></i>
                                @account.Username
                            </div>
                            <div class="small text-muted">
                                Tạo lúc @account.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </td>
                        <td>
                            @switch (account.Role)
                            {
                                case UserRole.Admin:
                                    <span class="badge badge-custom badge-rejected">
                                        <i class="fa-solid fa-shield-halved"></i> Quản trị viên
                                    </span>
                                    break;
                                case UserRole.Manager:
                                    <span class="badge badge-custom badge-primary-custom">
                                        <i class="fa-solid fa-user-gear"></i> Quản lý cửa hàng
                                    </span>
                                    break;
                                default:
                                    <span class="badge badge-custom badge-info-custom">
                                        <i class="fa-solid fa-user"></i> Nhân viên
                                    </span>
                                    break;
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(account.EmployeeName))
                            {
                                <div class="fw-semibold text-dark">@account.EmployeeName</div>
                                <div class="small text-muted font-monospace">@account.EmployeeCode</div>
                            }
                            else
                            {
                                <span class="text-muted">Chưa liên kết</span>
                            }
                        </td>
                        <td>
                            <span class="text-muted">
                                @(account.CreatedByUsername ?? "Dữ liệu khởi tạo")
                            </span>
                        </td>
                        <td>
                            @if (account.IsLocked)
                            {
                                <span class="badge badge-custom badge-rejected">
                                    <i class="fa-solid fa-lock"></i> Đã khóa
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-custom badge-active">
                                    <i class="fa-solid fa-circle-check"></i> Hoạt động
                                </span>
                            }
                        </td>
                        <td class="text-end pe-4 text-nowrap">
                            <a asp-action="Edit"
                               asp-route-id="@account.UserAccountId"
                               class="btn btn-sm btn-secondary-custom">
                                <i class="fa-solid fa-pen-to-square"></i> Sửa
                            </a>

                            <a asp-action="ResetPassword"
                               asp-route-id="@account.UserAccountId"
                               class="btn btn-sm btn-outline-primary">
                                <i class="fa-solid fa-key"></i> Đặt mật khẩu
                            </a>

                            <form asp-action="SetLock"
                                  asp-route-id="@account.UserAccountId"
                                  method="post"
                                  class="d-inline"
                                  data-prevent-double-submit="true">
                                <input type="hidden"
                                       name="isLocked"
                                       value="@(!account.IsLocked).ToString().ToLowerInvariant()" />
                                <button type="submit"
                                        class="btn btn-sm
                                        @(account.IsLocked ? "btn-outline-success" : "btn-outline-danger")"
                                        onclick="return confirm('Xác nhận thay đổi trạng thái tài khoản?')">
                                    <i class="fa-solid @(account.IsLocked ? "fa-lock-open" : "fa-lock")"></i>
                                    @(account.IsLocked ? "Mở khóa" : "Khóa")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>


@if (Model.Accounts.TotalPages > 1)
{
    <nav class="mt-4" aria-label="Phân trang">
        <ul class="pagination justify-content-center">
            <li class="page-item @(!Model.Accounts.HasPreviousPage ? "disabled" : string.Empty)">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-keyword="@Model.Keyword"
                   asp-route-page="@(Model.Accounts.Page - 1)"
                   asp-route-pageSize="@Model.Accounts.PageSize">Trước</a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">Trang @Model.Accounts.Page / @Model.Accounts.TotalPages</span>
            </li>
            <li class="page-item @(!Model.Accounts.HasNextPage ? "disabled" : string.Empty)">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-keyword="@Model.Keyword"
                   asp-route-page="@(Model.Accounts.Page + 1)"
                   asp-route-pageSize="@Model.Accounts.PageSize">Sau</a>
            </li>
        </ul>
    </nav>
}
