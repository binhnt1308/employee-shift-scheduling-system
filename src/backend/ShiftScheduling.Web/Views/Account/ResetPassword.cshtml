@model AccountResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Đặt lại mật khẩu</h1>
        <p class="page-subtitle">
            Tài khoản: <span class="font-monospace fw-bold">@Model.Username</span>
        </p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-secondary-custom">
            <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="card card-custom">
            <div class="card-header-custom">
                <i class="fa-solid fa-key text-primary me-2"></i>
                Mật khẩu mới
            </div>
            <div class="card-body p-4">
                <form method="post"
                      asp-action="ResetPassword"
                      asp-route-id="@Model.UserAccountId"
                      data-prevent-double-submit="true">
                    <input asp-for="UserAccountId" type="hidden" />
                    <input asp-for="Username" type="hidden" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-semibold"></label>
                        <input asp-for="NewPassword" class="form-control form-control-custom" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                        <input asp-for="ConfirmPassword" class="form-control form-control-custom" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="alert alert-custom alert-custom-warning mb-4">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i>
                        Sau khi đặt lại, người dùng phải sử dụng mật khẩu mới ở lần đăng nhập tiếp theo.
                    </div>

                    <div class="d-flex gap-2 pt-3 border-top">
                        <button type="submit"
                                class="btn btn-primary-custom flex-grow-1 justify-content-center">
                            <i class="fa-solid fa-key me-1"></i>
                            Cập nhật mật khẩu
                        </button>
                        <a asp-action="Index" class="btn btn-secondary-custom">Hủy bỏ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
