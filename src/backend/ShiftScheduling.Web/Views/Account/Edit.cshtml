@model AccountEditViewModel
@* Form cập nhật tên đăng nhập, vai trò và liên kết hồ sơ của tài khoản. *@
@{
    ViewData["Title"] = "Cập nhật tài khoản";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Cập nhật tài khoản</h1>
        <p class="page-subtitle">Thay đổi tên đăng nhập, vai trò và hồ sơ nhân viên liên kết</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-secondary-custom">
            <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <div class="card card-custom">
            <div class="card-header-custom">
                <i class="fa-solid fa-user-gear text-primary me-2"></i>
                Thông tin tài khoản
            </div>
            <div class="card-body p-4">
                <form method="post" asp-action="Edit" asp-route-id="@Model.UserAccountId" data-prevent-double-submit="true">
                    <input asp-for="UserAccountId" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Username" class="form-label fw-semibold"></label>
                            <input asp-for="Username" class="form-control form-control-custom" />
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Role" class="form-label fw-semibold"></label>
                            <select asp-for="Role" class="form-select form-select-custom">
                                <option value="@UserRole.Admin">Quản trị viên</option>
                                <option value="@UserRole.Manager">Quản lý cửa hàng</option>
                                <option value="@UserRole.Employee">Nhân viên</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="EmployeeId" class="form-label fw-semibold"></label>
                        <select asp-for="EmployeeId" class="form-select form-select-custom">
                            <option value="">-- Chưa liên kết --</option>
                            @foreach (var employee in Model.EmployeeOptions)
                            {
                                <option value="@employee.EmployeeId">
                                    @employee.EmployeeCode - @employee.FullName
                                </option>
                            }
                        </select>
                        <div class="form-text">
                            Chỉ chọn hồ sơ khi vai trò là Nhân viên. Mỗi hồ sơ chỉ liên kết một tài khoản.
                        </div>
                    </div>

                    <div class="alert alert-custom
                                @(Model.IsLocked ? "alert-custom-danger" : "alert-custom-success") mb-4">
                        <i class="fa-solid @(Model.IsLocked ? "fa-lock" : "fa-circle-check") me-2"></i>
                        Trạng thái hiện tại: <strong>@(Model.IsLocked ? "Đã khóa" : "Đang hoạt động")</strong>.
                        Thao tác khóa/mở khóa được thực hiện tại trang danh sách.
                    </div>

                    <div class="d-flex gap-2 pt-3 border-top">
                        <button type="submit"
                                class="btn btn-primary-custom flex-grow-1 justify-content-center">
                            <i class="fa-solid fa-floppy-disk me-1"></i>
                            Lưu thay đổi
                        </button>
                        <a asp-action="Index" class="btn btn-secondary-custom">Hủy bỏ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
