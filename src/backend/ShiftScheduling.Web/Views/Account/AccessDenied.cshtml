@* Thông báo người dùng không có quyền truy cập chức năng vừa yêu cầu. *@
@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card card-custom p-5 text-center">
            <i class="fa-solid fa-shield-halved text-danger display-4 mb-3"></i>
            <h2 class="fw-bold">Không có quyền truy cập</h2>
            <p class="text-muted">
                Tài khoản hiện tại không được phép sử dụng chức năng này.
            </p>
            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-primary-custom justify-content-center">
                Quay về trang chính
            </a>
        </div>
    </div>
</div>
