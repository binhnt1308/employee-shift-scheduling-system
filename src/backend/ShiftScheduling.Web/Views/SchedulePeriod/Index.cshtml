@model SchedulePeriodIndexViewModel
@* Danh sách kỳ lịch và trạng thái hiệu lực dùng cho các thao tác quản lý lịch. *@
@{
    ViewData["Title"] = "Quản lý kỳ lịch";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Quản lý kỳ lịch & định mức ca</h1>
        <p class="page-subtitle">Thiết lập kỳ lịch làm việc theo tuần và định mức nhân sự cho từng ca.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary-custom">
            <i class="fa-solid fa-plus me-1"></i>
            Tạo kỳ lịch mới
        </a>
    </div>
</div>

@if (TempData["StatusMessage"] is string statusMsg)
{
    <div class="alert alert-custom alert-custom-success alert-dismissible fade show mb-4" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@statusMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] is string errorMsg)
{
    <div class="alert alert-custom alert-custom-danger alert-dismissible fade show mb-4" role="alert">
        <i class="fa-solid fa-circle-exclamation me-2"></i>@errorMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card card-custom">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-custom align-middle mb-0">
                <thead>
                    <tr>
                        <th>Tên kỳ lịch</th>
                        <th>Khoảng thời gian (7 ngày)</th>
                        <th>Hạn đăng ký lịch rảnh</th>
                        <th>Trạng thái</th>
                        <th>Người tạo</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Periods.Items.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="fa-regular fa-folder-open me-2"></i>Chưa có kỳ lịch nào được tạo.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var period in Model.Periods.Items)
                        {
                            <tr>
                                <td>
                                    <span class="fw-semibold">@period.PeriodName</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border font-monospace">
                                        <i class="fa-regular fa-calendar me-1"></i>
                                        @period.WeekStartDate.ToString("dd/MM/yyyy") - @period.WeekEndDate.ToString("dd/MM/yyyy")
                                    </span>
                                </td>
                                <td>
                                    <span class="@(period.IsDeadlineExpired ? "text-danger fw-semibold" : "text-dark")">
                                        <i class="fa-regular fa-clock me-1"></i>
                                        @period.AvailabilityDeadline.ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge badge-custom @period.DisplayBadgeClass">
                                        @period.EffectiveStatusName
                                    </span>
                                    @if (period.NeedsAttention)
                                    {
                                        <span class="badge bg-danger ms-1">Cần xử lý</span>
                                    }
                                </td>
                                <td>@period.CreatedByUsername</td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@period.SchedulePeriodId" class="btn btn-sm btn-secondary-custom me-1">
                                        <i class="fa-solid fa-circle-info me-1"></i>Chi tiết
                                    </a>
                                    @if (period.RegistrationStatus == RegistrationStatus.Preparing)
                                    {
                                        <a asp-action="EditStaffing" asp-route-id="@period.SchedulePeriodId" class="btn btn-sm btn-secondary-custom">
                                            <i class="fa-solid fa-sliders me-1"></i>Định mức
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

