@model DashboardViewModel

@{
var isRegPrimary = Model.IsRegistrationOpen;
var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
var isAvailabilityActive = string.Equals(currentController, "Availability", StringComparison.OrdinalIgnoreCase);
var isScheduleActive = string.Equals(currentController, "MySchedule", StringComparison.OrdinalIgnoreCase);
var isLeaveActive = string.Equals(currentController, "LeaveRequest", StringComparison.OrdinalIgnoreCase);
var isTransferActive = string.Equals(currentController, "ShiftTransfer", StringComparison.OrdinalIgnoreCase);
var isReportActive = string.Equals(currentController, "Report", StringComparison.OrdinalIgnoreCase) && string.Equals(currentAction, "MyReport", StringComparison.OrdinalIgnoreCase);

}

<!-- 1. Lời chào -->
<div class="card card-custom dashboard-banner-employee p-4 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
        <div>
            <h4 class="fw-bold mb-1 text-dark">
                Xin chào, @(Model.EmployeeFullName ?? User.Identity?.Name) 👋
            </h4>
            <p class="text-muted mb-2">
                Chúc bạn một ngày làm việc hiệu quả!
            </p>
            <div class="d-flex align-items-center gap-2 text-muted small">
                <i class="fa-regular fa-calendar-days text-primary"></i>
                <span><strong>@Model.EmployeePeriodLabel:</strong> @(Model.TargetPeriodDateRange ?? "Chưa có kỳ lịch")</span>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge badge-custom @Model.EmployeeScheduleBadgeClass fs-6 px-3 py-2">
                @if (Model.HasSchedule && Model.HasMySchedule)
                {
                    <i class="fa-solid fa-circle-check me-1"></i>
                }
                else if (Model.IsRegistrationOpen)
                {
                    <i class="fa-solid fa-calendar-check me-1"></i>
                }
                else
                {
                    <i class="fa-regular fa-clock me-1"></i>
                }
                @Model.EmployeeScheduleStatusDisplay
            </span>
        </div>
    </div>
</div>

<!-- 2. Nội dung chính -->
<div class="row g-4">
    <!-- 3. Lịch làm việc trong tuần -->
    <div class="col-lg-8">
        <div class="card card-custom h-100 border-0 shadow-sm">
            <div class="card-header-custom py-3 px-4 d-flex justify-content-between align-items-center">
                <span class="fw-bold d-flex align-items-center gap-2">
                    <div class="card-header-icon-pill">
                        <i class="fa-solid fa-calendar-week"></i>
                    </div>
                    <span>Lịch làm việc tuần này</span>
                </span>
                @if (Model.HasSchedule)
                {
                    <a asp-controller="MySchedule" asp-action="Index" class="btn btn-sm btn-link text-decoration-none text-primary p-0 fw-semibold">
                        Xem đầy đủ <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                }
            </div>

            <div class="card-body p-3 p-md-4">
                @if (!Model.HasSchedule)
                {
                    <div class="text-center py-5">
                        <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle mb-3" style="width: 56px; height: 56px;">
                            <i class="fa-regular fa-clock fa-2x text-muted"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-1">Lịch làm việc chưa được công bố</h6>
                        <p class="text-muted small mb-0">Quản lý đang sắp xếp hoặc chưa công bố lịch làm việc chính thức cho kỳ này.</p>
                    </div>
                }
                else if (!Model.HasMySchedule)
                {
                    <div class="text-center py-5">
                        <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle mb-3" style="width: 56px; height: 56px;">
                            <i class="fa-regular fa-calendar-check fa-2x text-primary"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-1">Chưa có ca được phân công</h6>
                        <p class="text-muted small mb-0">Lịch làm việc kỳ này đã được công bố, nhưng bạn chưa có ca làm việc nào được phân công.</p>
                    </div>
                }
                else
                {
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <div class="text-muted small">
                            <i class="fa-solid fa-briefcase text-primary me-1"></i>
                            Phân công tuần này: <strong class="text-dark">@Model.EmployeeTotalAssignedShifts ca làm việc</strong>
                        </div>
                        <span class="badge badge-custom badge-active">
                            <i class="fa-solid fa-circle-check"></i> Đã công bố
                        </span>
                    </div>

                    <div class="row g-2 g-md-3">
                        @foreach (var day in Model.EmployeeWeekSchedule)
                        {
                            <div class="col-12 col-sm-6 col-xl-4">
                                <div class="p-3 rounded bg-light border h-100 @(day.IsToday ? "border-primary" : "")" style="@(day.IsToday ? "box-shadow: var(--shadow-sm);" : "")">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="fw-bold @(day.IsToday ? "text-primary" : "text-dark")">
                                            @day.DayOfWeekName
                                        </span>
                                        <div>
                                            @if (day.IsToday)
                                            {
                                                <span class="badge badge-custom badge-primary-custom me-1" style="font-size: 0.65rem;">Hôm nay</span>
                                            }
                                            <span class="text-muted small">@day.DateFormatted</span>
                                        </div>
                                    </div>

                                    @if (day.Shifts.Count > 0)
                                    {
                                        <div class="d-flex flex-column gap-2">
                                            @foreach (var shift in day.Shifts)
                                            {
                                                @if (shift.HasApprovedLeave)
                                                {
                                                    <div class="p-2 rounded border border-warning-subtle bg-warning-subtle">
                                                        <div class="d-flex align-items-center gap-2 text-warning-emphasis">
                                                            <i class="fa-solid fa-calendar-xmark"></i>
                                                            <span class="fw-semibold">Nghỉ đã duyệt</span>
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="p-2 rounded bg-white border border-light-subtle">
                                                        <div class="d-flex align-items-center gap-2 mb-1">
                                                            <i class="fa-regular fa-clock text-primary"></i>
                                                            <span class="fw-bold text-dark">@shift.ShiftName</span>
                                                        </div>
                                                        @if (!string.IsNullOrWhiteSpace(shift.ShiftHours))
                                                        {
                                                            <div class="text-muted small ps-3 font-monospace">
                                                                @shift.ShiftHours
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="p-2 rounded bg-white text-muted small border border-dashed text-center">
                                            <span class="opacity-75">Nghỉ</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- 4. Thao tác nhanh -->
    <div class="col-lg-4">
        <div class="card card-custom h-100 border-0 shadow-sm">
            <div class="card-header-custom py-3 px-4 d-flex align-items-center gap-2">
                <div class="card-header-icon-pill">
                    <i class="fa-solid fa-bolt"></i>
                </div>
                <span class="fw-bold">Thao tác nhanh</span>
            </div>

            <div class="card-body p-3 d-flex flex-column gap-2">
                <a asp-controller="Availability"
                   asp-action="Index"
                   class="employee-action-card @(isAvailabilityActive ? "active" : "")">
                    <div class="d-flex align-items-center gap-2">
                        <div class="action-icon-box">
                            <i class="fa-solid fa-user-clock"></i>
                        </div>
                        <span class="action-label">Đăng ký lịch rảnh</span>
                    </div>
                    @if (isRegPrimary)
                    {
                        <span class="badge badge-custom badge-primary-custom action-badge">Đang mở</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-chevron-right action-arrow"></i>
                    }
                </a>

                <a asp-controller="MySchedule"
                   asp-action="Index"
                   class="employee-action-card @(isScheduleActive ? "active" : "")">
                    <div class="d-flex align-items-center gap-2">
                        <div class="action-icon-box">
                            <i class="fa-solid fa-calendar-check"></i>
                        </div>
                        <span class="action-label">Lịch của tôi</span>
                    </div>
                    <i class="fa-solid fa-chevron-right action-arrow"></i>
                </a>

                <a asp-controller="LeaveRequest"
                   asp-action="Index"
                   class="employee-action-card @(isLeaveActive ? "active" : "")">
                    <div class="d-flex align-items-center gap-2">
                        <div class="action-icon-box">
                            <i class="fa-solid fa-calendar-minus"></i>
                        </div>
                        <span class="action-label">Xin nghỉ</span>
                    </div>
                    <i class="fa-solid fa-chevron-right action-arrow"></i>
                </a>

                <a asp-controller="ShiftTransfer"
                   asp-action="Index"
                   class="employee-action-card @(isTransferActive ? "active" : "")">
                    <div class="d-flex align-items-center gap-2">
                        <div class="action-icon-box">
                            <i class="fa-solid fa-right-left"></i>
                        </div>
                        <span class="action-label">Đổi ca</span>
                    </div>
                    <i class="fa-solid fa-chevron-right action-arrow"></i>
                </a>

                <a asp-controller="Report"
                   asp-action="MyReport"
                   class="employee-action-card @(isReportActive ? "active" : "")">
                    <div class="d-flex align-items-center gap-2">
                        <div class="action-icon-box">
                            <i class="fa-solid fa-chart-pie"></i>
                        </div>
                        <span class="action-label">Báo cáo ca</span>
                    </div>
                    <i class="fa-solid fa-chevron-right action-arrow"></i>
                </a>
            </div>
        </div>
    </div>
</div>
