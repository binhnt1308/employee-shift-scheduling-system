@using System.Security.Claims
@using ShiftScheduling.Models.Constants
@model DashboardViewModel
@* Điều phối Dashboard theo vai trò và chuyển ViewModel cho từng phần giao diện tương ứng. *@

@{
    ViewData["Title"] = "Tổng quan";

    var role = User.FindFirstValue(ClaimTypes.Role);
    var username = User.Identity?.Name ?? "Người dùng";
    var employeeFullName = User.FindFirstValue("EmployeeFullName");
    var displayName = !string.IsNullOrWhiteSpace(employeeFullName)
        ? employeeFullName
        : username;

    ViewData["DashboardDisplayName"] = displayName;
}

@if (role == RoleNames.Admin)
{
    <partial name="_AdminDashboard" model="Model" />
}
else if (role == RoleNames.Manager)
{
    <partial name="_ManagerDashboard" model="Model" />
}
else
{
    <partial name="_EmployeeDashboard" model="Model" />
}
