@using System.Security.Claims
@using ShiftScheduling.Models.Constants
@model DashboardViewModel
@{
    ViewData["Title"] = "Tổng quan";
    var role = User.FindFirstValue(ClaimTypes.Role);
    var isAdmin = role == RoleNames.Admin;
    var isStoreManager = role == RoleNames.Manager;
    var isEmployee = role == RoleNames.Employee;
    var canManageEmployees = isAdmin || isStoreManager;
    var username = User.Identity?.Name ?? "Người dùng";
    var empFullName = User.FindFirstValue("EmployeeFullName");
    var displayName = !string.IsNullOrWhiteSpace(empFullName) ? empFullName : username;
}

@if (isAdmin)
{
    <!-- 1. GREETING CARD (ADMIN) -->
    <div class="card card-custom dashboard-banner-admin p-4 mb-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
            <div>
                <h4 class="fw-bold mb-1 text-dark">
                    Xin chào, @displayName 👋
                </h4>
                <p class="text-muted mb-0">
                    Quản trị tài khoản và hồ sơ nhân sự
                </p>
            </div>
            <div>
                <span class="badge badge-custom badge-primary-custom fs-6 px-3 py-2">
                    <i class="fa-solid fa-user-shield me-1"></i>Quản trị viên
                </span>
            </div>
        </div>
    </div>

    <!-- 2. KPI CARDS (ADMIN: Chỉ Tài khoản & Nhân viên) -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card card-custom kpi-card-indigo border-0 shadow-sm h-100">
                <div class="card-body p-4 d-flex align-items-center gap-3">
                    <div class="kpi-icon-box flex-shrink-0">
                        <i class="fa-solid fa-user-shield"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Tài khoản</div>
                        <div class="display-6 fw-bold text-dark mb-0">@Model.AccountCount</div>
                        <div class="text-muted small">tài khoản hệ thống</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card card-custom kpi-card-sky border-0 shadow-sm h-100">
                <div class="card-body p-4 d-flex align-items-center gap-3">
                    <div class="kpi-icon-box flex-shrink-0">
                        <i class="fa-solid fa-users"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Nhân viên</div>
                        <div class="display-6 fw-bold text-dark mb-0">@Model.EmployeeCount</div>
                        <div class="text-muted small">hồ sơ nhân sự</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. QUICK ACTIONS (ADMIN: Chỉ 2 chức năng đúng quyền) -->
    <div class="card card-custom border-0 shadow-sm">
        <div class="card-header-custom py-3 px-4 d-flex align-items-center gap-2">
            <div class="d-flex align-items-center justify-content-center rounded-2" style="width: 28px; height: 28px; background: rgba(99, 102, 241, 0.12); color: #4f46e5; font-size: 0.9rem;">
                <i class="fa-solid fa-bolt"></i>
            </div>
            <span class="fw-bold">Chức năng quản trị</span>
        </div>
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-6">
                    <a asp-controller="Account"
                       asp-action="Index"
                       class="btn-action-card p-3 h-100">
                        <div class="d-flex align-items-center gap-3">
                            <div class="d-flex align-items-center justify-content-center rounded-3 flex-shrink-0" style="width: 44px; height: 44px; background: rgba(99, 102, 241, 0.12); color: #4f46e5; font-size: 1.2rem;">
                                <i class="fa-solid fa-user-shield"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark">Quản lý tài khoản</div>
                                <div class="text-muted small">Cấp quyền, khóa / mở khóa và đặt lại mật khẩu</div>
                            </div>
                        </div>
                        <i class="fa-solid fa-arrow-right text-primary fs-6 ms-2"></i>
                    </a>
                </div>

                <div class="col-md-6">
                    <a asp-controller="Employee"
                       asp-action="Index"
                       class="btn-action-card p-3 h-100">
                        <div class="d-flex align-items-center gap-3">
                            <div class="d-flex align-items-center justify-content-center rounded-3 flex-shrink-0" style="width: 44px; height: 44px; background: rgba(14, 165, 233, 0.12); color: #0284c7; font-size: 1.2rem;">
                                <i class="fa-solid fa-users"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark">Quản lý nhân viên</div>
                                <div class="text-muted small">Xem danh sách, thêm mới và cập nhật hồ sơ</div>
                            </div>
                        </div>
                        <i class="fa-solid fa-arrow-right text-primary fs-6 ms-2"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
}
else if (isStoreManager)
{
    var scheduleBadgeClass = "badge-info-custom";
    var scheduleStatusIcon = "fa-calendar-days";
    if (Model.HasSchedule)
    {
        scheduleBadgeClass = "badge-active";
        scheduleStatusIcon = "fa-circle-check";
    }
    else if (Model.IsRegistrationOpen)
    {
        scheduleBadgeClass = "badge-primary-custom";
        scheduleStatusIcon = "fa-calendar-check";
    }
    else if (Model.NeedsAttention)
    {
        scheduleBadgeClass = "badge-pending";
        scheduleStatusIcon = "fa-triangle-exclamation";
    }
    else if (Model.ScheduleStatusDisplay == "Chưa có kỳ lịch" || Model.ScheduleStatusDisplay == "Đã kết thúc")
    {
        scheduleBadgeClass = "badge-ended";
        scheduleStatusIcon = "fa-calendar-xmark";
    }

    <!-- 1. GREETING & CURRENT PERIOD CARD (MANAGER) -->
    <div class="card card-custom dashboard-banner-manager p-4 mb-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
            <div>
                <h4 class="fw-bold mb-1 text-dark">
                    Xin chào, @displayName 👋
                </h4>
                <p class="text-muted mb-2">
                    Tổng quan hoạt động của kỳ lịch hiện tại
                </p>
                <div class="d-flex align-items-center gap-2 text-muted small">
                    <i class="fa-regular fa-calendar-days text-primary"></i>
                    <span><strong>Kỳ lịch:</strong> @(Model.TargetPeriodName ?? "Chưa có kỳ lịch")</span>
                    @if (!string.IsNullOrEmpty(Model.TargetPeriodDateRange))
                    {
                        <span class="text-muted">(@Model.TargetPeriodDateRange)</span>
                    }
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="badge badge-custom @scheduleBadgeClass fs-6 px-3 py-2">
                    <i class="fa-solid @scheduleStatusIcon me-1"></i>
                    @Model.ScheduleStatusDisplay
                </span>
                @if (Model.NeedsAttention)
                {
                    <span class="badge badge-custom badge-pending fs-6 px-3 py-2" title="@Model.AttentionMessage">
                        <i class="fa-solid fa-triangle-exclamation me-1"></i>Cần xử lý
                    </span>
                }
            </div>
        </div>
    </div>

    <!-- 2. KPI SUMMARY CARDS (MANAGER: Nhân viên, Ca làm, Trạng thái lịch) -->
    <div class="row g-3 mb-4">
        <!-- Card 1: Nhân sự (Teal) -->
        <div class="col-md-4">
            <div class="card card-custom kpi-card-teal border-0 shadow-sm h-100">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="kpi-icon-box flex-shrink-0">
                        <i class="fa-solid fa-users"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Nhân viên</div>
                        <div class="fs-4 fw-bold text-dark mb-0">@Model.EmployeeCount</div>
                        <div class="text-muted small" style="font-size: 0.75rem;">hồ sơ nhân sự</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2: Ca đang áp dụng (Amber) -->
        <div class="col-md-4">
            <div class="card card-custom kpi-card-amber border-0 shadow-sm h-100">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="kpi-icon-box flex-shrink-0">
                        <i class="fa-regular fa-clock"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Ca đang áp dụng</div>
                        <div class="fs-4 fw-bold text-dark mb-0">@Model.ShiftTypeCount</div>
                        <div class="text-muted small" style="font-size: 0.75rem;">ca hoạt động</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 3: Lịch làm việc (Rose) -->
        <div class="col-md-4">
            <div class="card card-custom kpi-card-rose border-0 shadow-sm h-100">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="kpi-icon-box flex-shrink-0">
                        <i class="fa-solid fa-calendar-week"></i>
                    </div>
                    <div class="overflow-hidden">
                        <div class="text-muted small">Lịch làm việc</div>
                        <div class="fs-5 fw-bold text-dark text-truncate mb-0" title="@Model.ScheduleStatusDisplay">
                            @Model.ScheduleStatusDisplay
                        </div>
                        <div class="text-muted small text-truncate" style="font-size: 0.75rem;">
                            @(Model.TargetPeriodName ?? "Chưa có kỳ lịch")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. MAIN CONTENT: Ca làm việc (col-lg-6) & Thao tác nhanh (col-lg-6) -->
    <div class="row g-4">
        <!-- Danh sách ca làm việc -->
        <div class="col-lg-6">
            <div class="card card-custom h-100 border-0 shadow-sm">
                <div class="card-header-custom d-flex justify-content-between align-items-center py-3 px-4">
                    <span class="fw-bold d-flex align-items-center gap-2">
                        <div class="d-flex align-items-center justify-content-center rounded-2" style="width: 28px; height: 28px; background: rgba(79, 70, 229, 0.10); color: var(--primary); font-size: 0.9rem;">
                            <i class="fa-regular fa-clock"></i>
                        </div>
                        <span>Danh sách ca làm việc</span>
                    </span>
                    <a asp-controller="ShiftType" asp-action="Index" class="btn btn-sm btn-link text-decoration-none text-primary p-0 fw-semibold">
                        Cấu hình ca <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                </div>

                <div class="card-body p-3">
                    <div class="list-group list-group-flush">
                        @if (Model.ShiftTypes.Count == 0)
                        {
                            <div class="list-group-item text-center text-muted py-4 border-0">
                                Chưa có ca làm việc nào trong hệ thống.
                            </div>
                        }
                        else
                        {
                            @foreach (var shift in Model.ShiftTypes)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center px-2 py-2">
                                    <div>
                                        <strong class="text-dark">@shift.ShiftName</strong>
                                        <div class="text-muted font-monospace small">
                                            @shift.StartTime.ToString("HH:mm") - @shift.EndTime.ToString("HH:mm")
                                        </div>
                                    </div>

                                    <span class="badge badge-custom badge-active">
                                        <i class="fa-solid fa-circle-check me-1"></i>Đang áp dụng
                                    </span>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Thao tác nhanh: 8 chức năng vận hành của Manager -->
        <div class="col-lg-6">
            <div class="card card-custom h-100 border-0 shadow-sm">
                <div class="card-header-custom py-3 px-4 d-flex align-items-center gap-2">
                    <div class="d-flex align-items-center justify-content-center rounded-2" style="width: 28px; height: 28px; background: rgba(79, 70, 229, 0.10); color: var(--primary); font-size: 0.9rem;">
                        <i class="fa-solid fa-bolt"></i>
                    </div>
                    <span class="fw-bold">Thao tác nhanh</span>
                </div>

                <div class="card-body p-3">
                    <div class="row g-2">
                        <!-- 1. Phân công lịch -->
                        <div class="col-12 col-sm-6">
                            <a asp-controller="WorkSchedule"
                               asp-action="Index"
                               class="btn-action-card h-100">
                                <div>
                                    <div class="fw-bold text-dark small">Phân công lịch</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">Tự động & thủ công</div>
                                </div>
                                <div class="action-icon-box">
                                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                                </div>
                            </a>
                        </div>

                        <!-- 2. Quản lý kỳ lịch -->
                        <div class="col-12 col-sm-6">
                            <a asp-controller="SchedulePeriod"
                               asp-action="Index"
                               class="btn-action-card h-100">
                                <div>
                                    <div class="fw-bold text-dark small">Kỳ lịch</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">Thiết lập & đăng ký</div>
                                </div>
                                <div class="action-icon-box">
                                    <i class="fa-solid fa-calendar-week"></i>
                                </div>
                            </a>
                        </div>

                        <!-- 3. Lịch rảnh NV -->
                        <div class="col-12 col-sm-6">
                            <a asp-controller="Availability"
                               asp-action="Overview"
                               class="btn-action-card h-100">
                                <div>
                                    <div class="fw-bold text-dark small">Lịch rảnh NV</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">Theo dõi đăng ký</div>
                                </div>
                                <div class="action-icon-box">
                                    <i class="fa-solid fa-users-viewfinder"></i>
                                </div>
                            </a>
                        </div>

                        <!-- 4. Báo cáo tổng hợp -->
                        <div class="col-12 col-sm-6">
                            <a asp-controller="Report"
                               asp-action="Index"
                               class="btn-action-card h-100">
                                <div>
                                    <div class="fw-bold text-dark small">Báo cáo</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">Tổng hợp ca & giờ</div>
                                </div>
                                <div class="action-icon-box">
                                    <i class="fa-solid fa-chart-column"></i>
                                </div>
                            </a>
                        </div>

                        <!-- 5. Quản lý nhân viên -->
                        <div class="col-12 col-sm-6">
                            <a asp-controller="Employee"
                               asp-action="Index"
                               class="btn-action-card h-100">
                                <div>
                                    <div class="fw-bold text-dark small">Nhân viên</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">Hồ sơ & hợp đồng</div>
                                </div>
                                <div class="action-icon-box">
                                    <i class="fa-solid fa-users"></i>
                                </div>
                            </a>
                        </div>

                        <!-- 6. Cấu hình ca làm -->
                        <div class="col-12 col-sm-6">
                            <a asp-controller="ShiftType"
                               asp-action="Index"
                               class="btn-action-card h-100">
                                <div>
                                    <div class="fw-bold text-dark small">Ca làm việc</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">Khung giờ & định biên</div>
                                </div>
                                <div class="action-icon-box">
                                    <i class="fa-regular fa-clock"></i>
                                </div>
                            </a>
                        </div>

                        <!-- 7. Đơn xin nghỉ -->
                        <div class="col-12 col-sm-6">
                            <a asp-controller="LeaveRequest"
                               asp-action="Index"
                               class="btn-action-card h-100">
                                <div>
                                    <div class="fw-bold text-dark small">Đơn xin nghỉ</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">Duyệt nghỉ phép</div>
                                </div>
                                <div class="action-icon-box">
                                    <i class="fa-solid fa-calendar-minus"></i>
                                </div>
                            </a>
                        </div>

                        <!-- 8. Quản lý đổi ca -->
                        <div class="col-12 col-sm-6">
                            <a asp-controller="ShiftTransfer"
                               asp-action="Index"
                               class="btn-action-card h-100">
                                <div>
                                    <div class="fw-bold text-dark small">Quản lý đổi ca</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">Phê duyệt hoán đổi</div>
                                </div>
                                <div class="action-icon-box">
                                    <i class="fa-solid fa-right-left"></i>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    var isRegPrimary = Model.IsRegistrationOpen;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var isAvailabilityActive = string.Equals(currentController, "Availability", StringComparison.OrdinalIgnoreCase);
    var isScheduleActive = string.Equals(currentController, "MySchedule", StringComparison.OrdinalIgnoreCase);
    var isLeaveActive = string.Equals(currentController, "LeaveRequest", StringComparison.OrdinalIgnoreCase);
    var isTransferActive = string.Equals(currentController, "ShiftTransfer", StringComparison.OrdinalIgnoreCase);
    var isReportActive = string.Equals(currentController, "Report", StringComparison.OrdinalIgnoreCase) && string.Equals(currentAction, "MyReport", StringComparison.OrdinalIgnoreCase);

    <!-- 1. GREETING CARD -->
    <div class="card card-custom dashboard-banner-employee p-4 mb-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
            <div>
                <h4 class="fw-bold mb-1 text-dark">
                    Xin chào, @(Model.EmployeeFullName ?? User.Identity?.Name) 👋
                </h4>
                <p class="text-muted mb-2">
                    Chúc bạn một ngày làm việc hiệu quả!
                </p>
                <div class="d-flex align-items-center gap-2 text-muted small">
                    <i class="fa-regular fa-calendar-days text-primary"></i>
                    <span><strong>@Model.EmployeePeriodLabel:</strong> @(Model.TargetPeriodDateRange ?? "Chưa có kỳ lịch")</span>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge badge-custom @Model.EmployeeScheduleBadgeClass fs-6 px-3 py-2">
                    @if (Model.HasSchedule && Model.HasMySchedule)
                    {
                        <i class="fa-solid fa-circle-check me-1"></i>
                    }
                    else if (Model.IsRegistrationOpen)
                    {
                        <i class="fa-solid fa-calendar-check me-1"></i>
                    }
                    else
                    {
                        <i class="fa-regular fa-clock me-1"></i>
                    }
                    @Model.EmployeeScheduleStatusDisplay
                </span>
            </div>
        </div>
    </div>

    <!-- 2. MAIN SECTION -->
    <div class="row g-4">
        <!-- 3. WEEK SCHEDULE (col-lg-8) -->
        <div class="col-lg-8">
            <div class="card card-custom h-100 border-0 shadow-sm">
                <div class="card-header-custom py-3 px-4 d-flex justify-content-between align-items-center">
                    <span class="fw-bold d-flex align-items-center gap-2">
                        <div class="card-header-icon-pill">
                            <i class="fa-solid fa-calendar-week"></i>
                        </div>
                        <span>Lịch làm việc tuần này</span>
                    </span>
                    @if (Model.HasSchedule)
                    {
                        <a asp-controller="MySchedule" asp-action="Index" class="btn btn-sm btn-link text-decoration-none text-primary p-0 fw-semibold">
                            Xem đầy đủ <i class="fa-solid fa-arrow-right ms-1"></i>
                        </a>
                    }
                </div>

                <div class="card-body p-3 p-md-4">
                    @if (!Model.HasSchedule)
                    {
                        <div class="text-center py-5">
                            <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle mb-3" style="width: 56px; height: 56px;">
                                <i class="fa-regular fa-clock fa-2x text-muted"></i>
                            </div>
                            <h6 class="fw-bold text-dark mb-1">Lịch làm việc chưa được công bố</h6>
                            <p class="text-muted small mb-0">Quản lý đang sắp xếp hoặc chưa công bố lịch làm việc chính thức cho kỳ này.</p>
                        </div>
                    }
                    else if (!Model.HasMySchedule)
                    {
                        <div class="text-center py-5">
                            <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle mb-3" style="width: 56px; height: 56px;">
                                <i class="fa-regular fa-calendar-check fa-2x text-primary"></i>
                            </div>
                            <h6 class="fw-bold text-dark mb-1">Chưa có ca được phân công</h6>
                            <p class="text-muted small mb-0">Lịch làm việc kỳ này đã được công bố, nhưng bạn chưa có ca làm việc nào được phân công.</p>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                            <div class="text-muted small">
                                <i class="fa-solid fa-briefcase text-primary me-1"></i>
                                Phân công tuần này: <strong class="text-dark">@Model.EmployeeTotalAssignedShifts ca làm việc</strong>
                            </div>
                            <span class="badge badge-custom badge-active">
                                <i class="fa-solid fa-circle-check"></i> Đã công bố
                            </span>
                        </div>

                        <div class="row g-2 g-md-3">
                            @foreach (var day in Model.EmployeeWeekSchedule)
                            {
                                <div class="col-12 col-sm-6 col-xl-4">
                                    <div class="p-3 rounded bg-light border h-100 @(day.IsToday ? "border-primary" : "")" style="@(day.IsToday ? "box-shadow: var(--shadow-sm);" : "")">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="fw-bold @(day.IsToday ? "text-primary" : "text-dark")">
                                                @day.DayOfWeekName
                                            </span>
                                            <div>
                                                @if (day.IsToday)
                                                {
                                                    <span class="badge badge-custom badge-primary-custom me-1" style="font-size: 0.65rem;">Hôm nay</span>
                                                }
                                                <span class="text-muted small">@day.DateFormatted</span>
                                            </div>
                                        </div>

                                        @if (day.Shifts.Count > 0)
                                        {
                                            <div class="d-flex flex-column gap-2">
                                                @foreach (var shift in day.Shifts)
                                                {
                                                    <div class="p-2 rounded bg-white border border-light-subtle">
                                                        <div class="d-flex align-items-center gap-2 mb-1">
                                                            <i class="fa-regular fa-clock text-primary"></i>
                                                            <span class="fw-bold text-dark">@shift.ShiftName</span>
                                                        </div>
                                                        @if (!string.IsNullOrWhiteSpace(shift.ShiftHours))
                                                        {
                                                            <div class="text-muted small ps-3 font-monospace">
                                                                @shift.ShiftHours
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="p-2 rounded bg-white text-muted small border border-dashed text-center">
                                                <span class="opacity-75">Nghỉ</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- 4. QUICK ACTIONS (col-lg-4) -->
        <div class="col-lg-4">
            <div class="card card-custom h-100 border-0 shadow-sm">
                <div class="card-header-custom py-3 px-4 d-flex align-items-center gap-2">
                    <div class="card-header-icon-pill">
                        <i class="fa-solid fa-bolt"></i>
                    </div>
                    <span class="fw-bold">Thao tác nhanh</span>
                </div>

                <div class="card-body p-3 d-flex flex-column gap-2">
                    <a asp-controller="Availability"
                       asp-action="Index"
                       class="employee-action-card @(isAvailabilityActive ? "active" : "")">
                        <div class="d-flex align-items-center gap-2">
                            <div class="action-icon-box">
                                <i class="fa-solid fa-user-clock"></i>
                            </div>
                            <span class="action-label">Đăng ký lịch rảnh</span>
                        </div>
                        @if (isRegPrimary)
                        {
                            <span class="badge badge-custom badge-primary-custom action-badge">Đang mở</span>
                        }
                        else
                        {
                            <i class="fa-solid fa-chevron-right action-arrow"></i>
                        }
                    </a>

                    <a asp-controller="MySchedule"
                       asp-action="Index"
                       class="employee-action-card @(isScheduleActive ? "active" : "")">
                        <div class="d-flex align-items-center gap-2">
                            <div class="action-icon-box">
                                <i class="fa-solid fa-calendar-check"></i>
                            </div>
                            <span class="action-label">Lịch của tôi</span>
                        </div>
                        <i class="fa-solid fa-chevron-right action-arrow"></i>
                    </a>

                    <a asp-controller="LeaveRequest"
                       asp-action="Index"
                       class="employee-action-card @(isLeaveActive ? "active" : "")">
                        <div class="d-flex align-items-center gap-2">
                            <div class="action-icon-box">
                                <i class="fa-solid fa-calendar-minus"></i>
                            </div>
                            <span class="action-label">Xin nghỉ</span>
                        </div>
                        <i class="fa-solid fa-chevron-right action-arrow"></i>
                    </a>

                    <a asp-controller="ShiftTransfer"
                       asp-action="Index"
                       class="employee-action-card @(isTransferActive ? "active" : "")">
                        <div class="d-flex align-items-center gap-2">
                            <div class="action-icon-box">
                                <i class="fa-solid fa-right-left"></i>
                            </div>
                            <span class="action-label">Đổi ca</span>
                        </div>
                        <i class="fa-solid fa-chevron-right action-arrow"></i>
                    </a>

                    <a asp-controller="Report"
                       asp-action="MyReport"
                       class="employee-action-card @(isReportActive ? "active" : "")">
                        <div class="d-flex align-items-center gap-2">
                            <div class="action-icon-box">
                                <i class="fa-solid fa-chart-pie"></i>
                            </div>
                            <span class="action-label">Báo cáo ca</span>
                        </div>
                        <i class="fa-solid fa-chevron-right action-arrow"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
}