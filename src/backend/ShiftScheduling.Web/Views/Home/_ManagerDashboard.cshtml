@model DashboardViewModel

@{
var scheduleBadgeClass = "badge-info-custom";
var scheduleStatusIcon = "fa-calendar-days";
if (Model.HasSchedule)
{
    scheduleBadgeClass = "badge-active";
    scheduleStatusIcon = "fa-circle-check";
}
else if (Model.IsRegistrationOpen)
{
    scheduleBadgeClass = "badge-primary-custom";
    scheduleStatusIcon = "fa-calendar-check";
}
else if (Model.NeedsAttention)
{
    scheduleBadgeClass = "badge-pending";
    scheduleStatusIcon = "fa-triangle-exclamation";
}
else if (Model.ScheduleStatusDisplay == "Chưa có kỳ lịch" || Model.ScheduleStatusDisplay == "Đã kết thúc")
{
    scheduleBadgeClass = "badge-ended";
    scheduleStatusIcon = "fa-calendar-xmark";
}

}

<!-- 1. GREETING & CURRENT PERIOD CARD (MANAGER) -->
<div class="card card-custom dashboard-banner-manager p-4 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
        <div>
            <h4 class="fw-bold mb-1 text-dark">
                Xin chào, @ViewData["DashboardDisplayName"] 👋
            </h4>
            <p class="text-muted mb-2">
                Tổng quan hoạt động của kỳ lịch hiện tại
            </p>
            <div class="d-flex align-items-center gap-2 text-muted small">
                <i class="fa-regular fa-calendar-days text-primary"></i>
                <span><strong>Kỳ lịch:</strong> @(Model.TargetPeriodName ?? "Chưa có kỳ lịch")</span>
                @if (!string.IsNullOrEmpty(Model.TargetPeriodDateRange))
                {
                    <span class="text-muted">(@Model.TargetPeriodDateRange)</span>
                }
            </div>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="badge badge-custom @scheduleBadgeClass fs-6 px-3 py-2">
                <i class="fa-solid @scheduleStatusIcon me-1"></i>
                @Model.ScheduleStatusDisplay
            </span>
            @if (Model.NeedsAttention)
            {
                <span class="badge badge-custom badge-pending fs-6 px-3 py-2" title="@Model.AttentionMessage">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i>Cần xử lý
                </span>
            }
        </div>
    </div>
</div>

<!-- 2. KPI SUMMARY CARDS (MANAGER: Nhân viên, Ca làm, Trạng thái lịch) -->
<div class="row g-3 mb-4">
    <!-- Card 1: Nhân sự (Teal) -->
    <div class="col-md-4">
        <div class="card card-custom kpi-card-teal border-0 shadow-sm h-100">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <div class="kpi-icon-box flex-shrink-0">
                    <i class="fa-solid fa-users"></i>
                </div>
                <div>
                    <div class="text-muted small">Nhân viên</div>
                    <div class="fs-4 fw-bold text-dark mb-0">@Model.EmployeeCount</div>
                    <div class="text-muted small" style="font-size: 0.75rem;">hồ sơ nhân sự</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 2: Ca đang áp dụng (Amber) -->
    <div class="col-md-4">
        <div class="card card-custom kpi-card-amber border-0 shadow-sm h-100">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <div class="kpi-icon-box flex-shrink-0">
                    <i class="fa-regular fa-clock"></i>
                </div>
                <div>
                    <div class="text-muted small">Ca đang áp dụng</div>
                    <div class="fs-4 fw-bold text-dark mb-0">@Model.ShiftTypeCount</div>
                    <div class="text-muted small" style="font-size: 0.75rem;">ca hoạt động</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 3: Lịch làm việc (Rose) -->
    <div class="col-md-4">
        <div class="card card-custom kpi-card-rose border-0 shadow-sm h-100">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <div class="kpi-icon-box flex-shrink-0">
                    <i class="fa-solid fa-calendar-week"></i>
                </div>
                <div class="overflow-hidden">
                    <div class="text-muted small">Lịch làm việc</div>
                    <div class="fs-5 fw-bold text-dark text-truncate mb-0" title="@Model.ScheduleStatusDisplay">
                        @Model.ScheduleStatusDisplay
                    </div>
                    <div class="text-muted small text-truncate" style="font-size: 0.75rem;">
                        @(Model.TargetPeriodName ?? "Chưa có kỳ lịch")
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<partial name="_ManagerMainContent" model="Model" />
