@model DashboardViewModel

<!-- 1. Lời chào dành cho Quản trị viên -->
<div class="card card-custom dashboard-banner-admin p-4 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
        <div>
            <h4 class="fw-bold mb-1 text-dark">
                Xin chào, @ViewData["DashboardDisplayName"] 👋
            </h4>
            <p class="text-muted mb-0">
                Quản trị tài khoản và hồ sơ nhân sự
            </p>
        </div>
        <div>
            <span class="badge badge-custom badge-primary-custom fs-6 px-3 py-2">
                <i class="fa-solid fa-user-shield me-1"></i>Quản trị viên
            </span>
        </div>
    </div>
</div>

<!-- 2. KPI CARDS (ADMIN: Chỉ Tài khoản & Nhân viên) -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card card-custom kpi-card-indigo border-0 shadow-sm h-100">
            <div class="card-body p-4 d-flex align-items-center gap-3">
                <div class="kpi-icon-box flex-shrink-0">
                    <i class="fa-solid fa-user-shield"></i>
                </div>
                <div>
                    <div class="text-muted small">Tài khoản</div>
                    <div class="display-6 fw-bold text-dark mb-0">@Model.AccountCount</div>
                    <div class="text-muted small">tài khoản hệ thống</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card card-custom kpi-card-sky border-0 shadow-sm h-100">
            <div class="card-body p-4 d-flex align-items-center gap-3">
                <div class="kpi-icon-box flex-shrink-0">
                    <i class="fa-solid fa-users"></i>
                </div>
                <div>
                    <div class="text-muted small">Nhân viên</div>
                    <div class="display-6 fw-bold text-dark mb-0">@Model.EmployeeCount</div>
                    <div class="text-muted small">hồ sơ nhân sự</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 3. QUICK ACTIONS (ADMIN: Chỉ 2 chức năng đúng quyền) -->
<div class="card card-custom border-0 shadow-sm">
    <div class="card-header-custom py-3 px-4 d-flex align-items-center gap-2">
        <div class="d-flex align-items-center justify-content-center rounded-2" style="width: 28px; height: 28px; background: rgba(99, 102, 241, 0.12); color: #4f46e5; font-size: 0.9rem;">
            <i class="fa-solid fa-bolt"></i>
        </div>
        <span class="fw-bold">Chức năng quản trị</span>
    </div>
    <div class="card-body p-4">
        <div class="row g-3">
            <div class="col-md-6">
                <a asp-controller="Account"
                   asp-action="Index"
                   class="btn-action-card p-3 h-100">
                    <div class="d-flex align-items-center gap-3">
                        <div class="d-flex align-items-center justify-content-center rounded-3 flex-shrink-0" style="width: 44px; height: 44px; background: rgba(99, 102, 241, 0.12); color: #4f46e5; font-size: 1.2rem;">
                            <i class="fa-solid fa-user-shield"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-dark">Quản lý tài khoản</div>
                            <div class="text-muted small">Cấp quyền, khóa / mở khóa và đặt lại mật khẩu</div>
                        </div>
                    </div>
                    <i class="fa-solid fa-arrow-right text-primary fs-6 ms-2"></i>
                </a>
            </div>

            <div class="col-md-6">
                <a asp-controller="Employee"
                   asp-action="Index"
                   class="btn-action-card p-3 h-100">
                    <div class="d-flex align-items-center gap-3">
                        <div class="d-flex align-items-center justify-content-center rounded-3 flex-shrink-0" style="width: 44px; height: 44px; background: rgba(14, 165, 233, 0.12); color: #0284c7; font-size: 1.2rem;">
                            <i class="fa-solid fa-users"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-dark">Quản lý nhân viên</div>
                            <div class="text-muted small">Xem danh sách, thêm mới và cập nhật hồ sơ</div>
                        </div>
                    </div>
                    <i class="fa-solid fa-arrow-right text-primary fs-6 ms-2"></i>
                </a>
            </div>
        </div>
    </div>
</div>
