@using ShiftScheduling.Common.Time
@model ShiftScheduling.Features.Availabilities.ViewModels.ManagerAvailabilityOverviewViewModel
@{
    ViewData["Title"] = "Tổng quan lịch rảnh nhân viên";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="fa-solid fa-users-viewfinder text-primary me-2"></i>Lịch rảnh nhân viên</h3>
        <p class="text-muted small mb-0">Xem và lọc danh sách nhân viên đã đăng ký rảnh theo từng ngày và ca</p>
    </div>
</div>

@if (!Model.PeriodOptions.Any())
{
    <div class="card card-custom border-0 shadow-sm text-center py-5">
        <div class="card-body">
            <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle mb-3" style="width: 56px; height: 56px;">
                <i class="fa-regular fa-calendar-xmark fa-2x text-muted"></i>
            </div>
            <h5 class="fw-bold text-secondary">Chưa có kỳ xếp lịch</h5>
            <p class="text-muted mb-3">Chưa có kỳ xếp lịch để xem lịch rảnh.</p>
            <a asp-controller="SchedulePeriod" asp-action="Create" class="btn btn-sm btn-primary-custom">
                <i class="fa-solid fa-plus me-1"></i>Tạo kỳ lịch mới
            </a>
        </div>
    </div>
}
else
{
<div class="card card-custom border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-action="Overview" class="row g-3">
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Kỳ lịch</label>
                <select name="schedulePeriodId" class="form-select form-select-sm" onchange="this.form.submit()">
                    @foreach (var opt in Model.PeriodOptions)
                    {
                        <option value="@opt.SchedulePeriodId" selected="@(opt.SchedulePeriodId == Model.SchedulePeriodId ? "selected" : null)">@opt.PeriodName</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Nhân viên</label>
                <select name="employeeId" class="form-select form-select-sm">
                    <option value="">-- Tất cả nhân viên --</option>
                    @foreach (var emp in Model.EmployeeOptions)
                    {
                        <option value="@emp.EmployeeId" selected="@(emp.EmployeeId == Model.EmployeeIdFilter ? "selected" : null)">@emp.DisplayName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Vị trí</label>
                <select name="position" class="form-select form-select-sm">
                    <option value="">-- Tất cả --</option>
                    <option value="Sales" selected="@(Model.PositionFilter == ShiftScheduling.Models.Enums.EmployeePosition.Sales ? "selected" : null)">Tư vấn bán hàng</option>
                    <option value="Cashier" selected="@(Model.PositionFilter == ShiftScheduling.Models.Enums.EmployeePosition.Cashier ? "selected" : null)">Thu ngân</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Ca làm việc</label>
                <select name="shiftTypeId" class="form-select form-select-sm">
                    <option value="">-- Tất cả ca --</option>
                    @foreach (var st in Model.ShiftOptions)
                    {
                        <option value="@st.ShiftTypeId" selected="@(st.ShiftTypeId == Model.ShiftTypeIdFilter ? "selected" : null)">@st.ShiftName</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-sm btn-primary-custom w-100 me-2"><i class="fa-solid fa-filter me-1"></i>Lọc</button>
                <a asp-action="Overview" asp-route-schedulePeriodId="@Model.SchedulePeriodId" class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-rotate-left"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card card-custom border-0 shadow-sm mb-4">
    <div class="card-header bg-light py-3 fw-bold">
        <i class="fa-solid fa-table me-2"></i>@Model.PeriodName (@Model.WeekStartDate.ToString("dd/MM/yyyy") - @Model.WeekEndDate.ToString("dd/MM/yyyy"))
    </div>
    <div class="card-body p-0">
        <div class="px-3 py-2 bg-light border-bottom d-flex flex-wrap align-items-center gap-3 small text-muted">
            <span class="fw-semibold text-dark"><i class="fa-solid fa-circle-info text-primary me-1"></i>Chú thích:</span>
            <span><span class="text-warning fw-bold">★</span> Nguyện vọng ưu tiên</span>
            <span class="d-inline-flex align-items-center gap-1"><span class="legend-swatch legend-swatch-sales"></span> Tư vấn</span>
            <span class="d-inline-flex align-items-center gap-1"><span class="legend-swatch legend-swatch-cashier"></span> Thu ngân</span>
        </div>
        <div class="table-responsive">
            <table class="table table-bordered align-middle mb-0">
                <thead class="table-light text-center">
                    <tr>
                        <th style="width: 140px; min-width: 140px;">Ca làm việc</th>
                        @foreach (var day in Model.Days)
                        {
                            <th style="min-width: 220px;">
                                <div class="fw-bold">@day.WorkDate.DayOfWeek.ToShortVietnameseDay()</div>
                                <div class="text-muted small">@day.WorkDate.ToString("dd/MM")</div>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var st in Model.ShiftOptions)
                    {
                        var shiftTime = st.ShiftTypeId switch
                        {
                            1 => "08:00–12:00",
                            2 => "12:00–16:00",
                            3 => "16:00–20:00",
                            _ => ""
                        };
                        <tr class="calendar-shift-row @(st.ShiftTypeId == 2 ? "manager-calendar-afternoon" : "")">
                            <td class="calendar-shift-title-cell fw-semibold">
                                <div class="fw-bold">@st.ShiftName</div>
                                @if (!string.IsNullOrEmpty(shiftTime))
                                {
                                    <div class="text-muted small">@shiftTime</div>
                                }
                            </td>
                            @foreach (var day in Model.Days)
                            {
                                var shift = day.Shifts.FirstOrDefault(s => s.ShiftTypeId == st.ShiftTypeId);
                                <td class="calendar-cell">
                                    @if (shift != null)
                                    {
                                        var sortedEmployees = shift.AvailableEmployees
                                            .OrderByDescending(e => e.PreferenceLevel == ShiftScheduling.Models.Enums.AvailabilityPreferenceLevel.Preferred)
                                            .ThenBy(e => e.EmployeeCode)
                                            .ToList();

                                        <div class="calendar-cell-header justify-content-end">
                                            <span class="badge bg-light text-secondary border font-monospace">@sortedEmployees.Count người rảnh</span>
                                        </div>
                                        @if (!sortedEmployees.Any())
                                        {
                                            <div class="text-muted small italic text-center py-2">Chưa có nhân viên rảnh</div>
                                        }
                                        else
                                        {
                                            <div class="calendar-chips-container">
                                                @foreach (var emp in sortedEmployees)
                                                {
                                                    var isPreferred = emp.PreferenceLevel == ShiftScheduling.Models.Enums.AvailabilityPreferenceLevel.Preferred;
                                                    var posClass = emp.Position == ShiftScheduling.Models.Enums.EmployeePosition.Sales ? "employee-chip-sales" : "employee-chip-cashier";
                                                    var posName = emp.Position == ShiftScheduling.Models.Enums.EmployeePosition.Sales ? "Tư vấn" : "Thu ngân";
                                                    var levelName = emp.Level switch
                                                    {
                                                        ShiftScheduling.Models.Enums.EmployeeLevel.Level1 => "I",
                                                        ShiftScheduling.Models.Enums.EmployeeLevel.Level2 => "II",
                                                        ShiftScheduling.Models.Enums.EmployeeLevel.Level3 => "III",
                                                        _ => emp.Level.ToString()
                                                    };
                                                    var prefText = isPreferred ? "★ Nguyện vọng ưu tiên" : "Nguyện vọng bình thường";
                                                    var tooltipText = $"{emp.EmployeeCode} - {emp.FullName}&#10;{posName}&#10;{levelName}&#10;{prefText}";

                                                    <span class="employee-chip @posClass" tabindex="0" title="@Html.Raw(tooltipText)">
                                                        @if (isPreferred)
                                                        {
                                                            <span class="chip-star">★</span>
                                                        }
                                                        <span>@emp.EmployeeCode</span>
                                                    </span>
                                                }
                                            </div>
                                        }
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
}
