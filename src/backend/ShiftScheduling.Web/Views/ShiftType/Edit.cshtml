@model ShiftConfigurationEditViewModel
@* Form cập nhật đồng thời cấu hình ba ca cố định theo cơ chế tạo phiên bản mới. *@
@{
    ViewData["Title"] = "Cấu hình ca làm việc";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title mb-1">Cấu hình ca làm việc</h1>
        <p class="page-subtitle mb-0 text-muted">
            Thiết lập khung giờ làm việc áp dụng cho các kỳ lịch được tạo sau khi lưu cấu hình.
        </p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-secondary-custom">
            <i class="fa-solid fa-arrow-left me-1"></i>
            Quay lại
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="alert alert-info py-3 px-3 shadow-sm border-0 mb-4">
            <i class="fa-solid fa-circle-info text-primary fs-5 me-2"></i>
            <strong>Lưu ý quan trọng:</strong> Cấu hình mới chỉ áp dụng cho các kỳ lịch được tạo sau khi lưu. Các kỳ lịch đã tồn tại không bị thay đổi.
        </div>

        <form method="post" asp-action="Edit" data-prevent-double-submit="true">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ExpectedConfigurationVersion" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm border-0 mb-4"></div>

            <div class="card card-custom shadow-sm border-0 mb-4">
                <div class="card-header-custom py-3 fw-bold">
                    <i class="fa-regular fa-clock text-primary me-2"></i>
                    Khung giờ ba ca làm việc trong ngày
                </div>
                <div class="card-body p-4">
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle text-center mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 34%;">Ca làm việc</th>
                                    <th style="width: 33%;">Giờ bắt đầu</th>
                                    <th style="width: 33%;">Giờ kết thúc</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Shifts.Count; i++)
                                {
                                    <input type="hidden" asp-for="Shifts[i].ShiftTypeId" />
                                    <input type="hidden" asp-for="Shifts[i].ShiftCode" />
                                    <input type="hidden" asp-for="Shifts[i].ShiftName" />
                                    <input type="hidden" asp-for="Shifts[i].DisplayOrder" />

                                    <tr>
                                        <td class="text-start ps-3 fw-bold">
                                            @Model.Shifts[i].ShiftName
                                        </td>
                                        <td>
                                            <input asp-for="Shifts[i].StartTime"
                                                   type="time"
                                                   class="form-control form-control-custom text-center font-monospace"
                                                   required />
                                            <span asp-validation-for="Shifts[i].StartTime" class="text-danger small"></span>
                                        </td>
                                        <td>
                                            <input asp-for="Shifts[i].EndTime"
                                                   type="time"
                                                   class="form-control form-control-custom text-center font-monospace"
                                                   required />
                                            <span asp-validation-for="Shifts[i].EndTime" class="text-danger small"></span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-white py-3 d-flex justify-content-between align-items-center">
                    <span class="text-muted small">
                        <i class="fa-solid fa-triangle-exclamation text-warning me-1"></i>
                        Quy tắc: Ca Sáng kết thúc &le; Ca Chiều bắt đầu &le; Ca Chiều kết thúc &le; Ca Tối bắt đầu.
                    </span>
                    <button type="submit" class="btn btn-primary-custom px-4">
                        <i class="fa-solid fa-floppy-disk me-1"></i>
                        Cập nhật cấu hình ca
                    </button>
                </div>
            </div>

            <div class="card card-custom shadow-sm border-0 mb-4">
                <div class="card-header-custom py-3 fw-bold">
                    <i class="fa-solid fa-sliders text-primary me-2"></i>
                    Chính sách số ca làm việc trong ngày
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Số ca tối đa mỗi nhân viên trong ngày</label>
                        <div class="d-flex gap-4">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="MaxShiftsPerEmployeePerDay" value="1" id="maxShifts1">
                                <label class="form-check-label" for="maxShifts1">
                                    1 ca / ngày
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="MaxShiftsPerEmployeePerDay" value="2" id="maxShifts2">
                                <label class="form-check-label" for="maxShifts2">
                                    Tối đa 2 ca / ngày
                                </label>
                            </div>
                        </div>
                        <span asp-validation-for="MaxShiftsPerEmployeePerDay" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="AllowSplitShift" id="allowSplitShiftCheckbox">
                            <label class="form-check-label fw-semibold" for="allowSplitShiftCheckbox">
                                Cho phép ca gãy (Ca sáng và Ca tối)
                            </label>
                        </div>
                        <span asp-validation-for="AllowSplitShift" class="text-danger small"></span>
                    </div>

                    <div class="p-3 bg-light rounded-3 border">
                        <div class="small text-muted">
                            <i class="fa-solid fa-circle-info text-primary me-1"></i>
                            Nhân viên bán thời gian luôn tối đa 1 ca/ngày theo quy định hợp đồng.
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const radio1 = document.getElementById('maxShifts1');
            const radio2 = document.getElementById('maxShifts2');
            const splitCheckbox = document.getElementById('allowSplitShiftCheckbox');

            function updateSplitShiftState() {
                if (radio1 && radio1.checked) {
                    splitCheckbox.checked = false;
                    splitCheckbox.disabled = true;
                } else if (radio2 && radio2.checked) {
                    splitCheckbox.disabled = false;
                }
            }

            if (radio1 && radio2 && splitCheckbox) {
                radio1.addEventListener('change', updateSplitShiftState);
                radio2.addEventListener('change', updateSplitShiftState);
                updateSplitShiftState();
            }
        });
    </script>
}
