@model ShiftTypeEditViewModel
@{
    ViewData["Title"] = "Chỉnh sửa ca làm";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Chỉnh sửa @Model.ShiftName</h1>
        <p class="page-subtitle">Mã ca: @Model.ShiftCode</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-secondary-custom">
            <i class="fa-solid fa-arrow-left me-1"></i>
            Quay lại
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card card-custom">
            <div class="card-header-custom">
                <i class="fa-regular fa-clock text-primary me-2"></i>
                Thông tin ca làm việc
            </div>
            <div class="card-body p-4">
                <div class="alert alert-info py-2 px-3 small mb-3">
                    <i class="fa-solid fa-circle-info me-1"></i>
                    Khung giờ của ba ca được cố định: Ca sáng 08:00–12:00, Ca chiều 12:00–16:00, Ca tối 16:00–20:00.
                </div>

                <form method="post"
                      asp-action="Edit"
                      asp-route-id="@Model.ShiftTypeId">
                    <input asp-for="ShiftTypeId" type="hidden" />
                    <input asp-for="ShiftCode" type="hidden" />

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="ShiftName"
                               class="form-label fw-semibold"></label>
                        <input asp-for="ShiftName"
                               class="form-control form-control-custom" />
                        <span asp-validation-for="ShiftName"
                              class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="StartTime"
                                   class="form-label fw-semibold"></label>
                            <input asp-for="StartTime"
                                   type="time"
                                   readonly
                                   class="form-control form-control-custom bg-light" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EndTime"
                                   class="form-label fw-semibold"></label>
                            <input asp-for="EndTime"
                                   type="time"
                                   readonly
                                   class="form-control form-control-custom bg-light" />
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="DisplayOrder"
                                   class="form-label fw-semibold"></label>
                            <input asp-for="DisplayOrder"
                                   type="number"
                                   class="form-control form-control-custom" />
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check form-switch mb-2">
                                <input asp-for="IsActive"
                                       class="form-check-input"
                                       disabled
                                       checked />
                                <input type="hidden" asp-for="IsActive" value="true" />
                                <label asp-for="IsActive"
                                       class="form-check-label"></label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 pt-2 border-top">
                        <button type="submit"
                                class="btn btn-primary-custom flex-grow-1 justify-content-center">
                            <i class="fa-solid fa-floppy-disk me-1"></i>
                            Lưu thay đổi
                        </button>
                        <a asp-action="Index"
                           class="btn btn-secondary-custom">
                            Hủy bỏ
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
