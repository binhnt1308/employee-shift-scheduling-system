@model IReadOnlyList<ShiftTypeListItemViewModel>
@{
    ViewData["Title"] = "Cấu hình ca làm việc";
}

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1 class="page-title">Cấu hình ca làm việc</h1>
        <p class="page-subtitle">
            Thiết lập khung giờ làm việc áp dụng cho các kỳ lịch được tạo sau khi lưu cấu hình.
        </p>
    </div>
    <div>
        <a asp-action="Edit" class="btn btn-primary-custom">
            <i class="fa-solid fa-clock me-1"></i>
            Cập nhật giờ ca
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    @foreach (var shift in Model)
    {
        <div class="col-md-4">
            <div class="card card-custom h-100 card-custom-hover">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="badge badge-custom badge-primary-custom fs-6">
                            @shift.ShiftName
                        </span>
                        <span class="badge bg-secondary bg-opacity-10 text-dark border font-monospace">
                            @shift.DurationHours giờ
                        </span>
                    </div>

                    <div class="p-3 bg-light rounded-3 border mb-3 d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-2 d-flex align-items-center justify-content-center"
                             style="width:40px; height:40px;">
                            <i class="fa-regular fa-clock fs-5"></i>
                        </div>
                        <div>
                            <div class="small text-muted">Khung giờ làm việc</div>
                            <div class="fw-bold font-monospace text-primary fs-6">
                                @shift.StartTime.ToString("HH:mm")
                                -
                                @shift.EndTime.ToString("HH:mm")
                            </div>
                        </div>
                    </div>

                    <div class="d-flex align-items-center justify-content-between">
                        @if (shift.IsActive)
                        {
                            <span class="badge badge-custom badge-active">
                                <i class="fa-solid fa-circle-check"></i>
                                Đang áp dụng
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
